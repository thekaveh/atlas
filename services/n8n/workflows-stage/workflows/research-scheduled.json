{
  "name": "Scheduled Research Workflow",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "value": "0 9 * * MON"
            }
          ]
        }
      },
      "id": "a1b2c3d4-e5f6-g7h8-i9j0-k1l2m3n4o5p6",
      "name": "Weekly Schedule",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Define recurring research queries and carry schedule metadata per item.\nconst scheduledQueries = [\n  {\n    query: \"Latest AI and machine learning breakthroughs\",\n    priority: \"high\",\n    max_loops: 5\n  },\n  {\n    query: \"Technology industry trends and market analysis\",\n    priority: \"medium\",\n    max_loops: 3\n  },\n  {\n    query: \"Cybersecurity threats and vulnerabilities\",\n    priority: \"high\",\n    max_loops: 4\n  },\n  {\n    query: \"Open source software updates and releases\",\n    priority: \"low\",\n    max_loops: 2\n  }\n];\n\nconst batchId = `scheduled_${Date.now()}`;\nconst startedAt = new Date().toISOString();\nreturn scheduledQueries.map((item, index) => ({\n  ...item,\n  batchId,\n  scheduleType: 'weekly',\n  startedAt,\n  index,\n  scheduledAt: startedAt,\n  search_api: 'searxng'\n}));"
      },
      "id": "b3c4d5e6-f7g8-h9i0-j1k2-l3m4n5o6p7q8",
      "name": "Define Research Topics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/research/start",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $env.BACKEND_N8N_API_TOKEN }}"}]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.query }}"
            },
            {
              "name": "max_loops",
              "value": "={{ $json.max_loops }}"
            },
            {
              "name": "search_api",
              "value": "={{ $json.search_api }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "c5d6e7f8-g9h0-i1j2-k3l4-m5n6o7p8q9r0",
      "name": "Start Research Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Restore each scheduled request after HTTP Request replaced item JSON.\nconst requests = $('Define Research Topics').all();\nreturn $input.all().map((item, index) => ({\n  ...(requests[index]?.json || {}),\n  sessionId: item.json.session_id,\n  status: item.json.status || 'running'\n}));"
      },
      "id": "d7e8f9g0-h1i2-j3k4-l5m6-n7o8p9q0r1s2",
      "name": "Track Sessions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "minutes"
      },
      "id": "e9f0g1h2-i3j4-k5l6-m7n8-o9p0q1r2s3t4",
      "name": "Wait for Completion",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Recreate status requests from the durable tracked session items.\nreturn $('Track Sessions').all().map(item => ({ ...item.json }));"
      },
      "id": "f1g2h3i4-j5k6-l7m8-n9o0-p1q2r3s4t5u6",
      "name": "Prepare Status Checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "url": "=http://backend:8000/research/{{ $json.sessionId }}/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $env.BACKEND_N8N_API_TOKEN }}"}]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "scheduled-status-request",
      "name": "Check All Statuses",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1560,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Join status responses to their scheduled requests by session id.\nconst sessions = $('Track Sessions').all().map(item => item.json);\nconst sessionStatuses = $input.all().map(item => {\n  const response = item.json;\n  const original = sessions.find(session => session.sessionId === response.session_id) || {};\n  return {\n    ...original,\n    sessionId: response.session_id || original.sessionId,\n    status: response.status,\n    errorMessage: response.error_message || null\n  };\n});\nconst completedCount = sessionStatuses.filter(item => item.status === 'completed').length;\nconst failedCount = sessionStatuses.filter(item => ['failed', 'cancelled'].includes(item.status)).length;\nreturn [{\n  allCompleted: completedCount + failedCount === sessionStatuses.length,\n  completedCount,\n  failedCount,\n  sessionStatuses\n}];"
      },
      "id": "scheduled-status-analysis",
      "name": "Analyze Scheduled Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "scheduled-complete",
              "leftValue": "={{ $json.allCompleted }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "scheduled-completion-guard",
      "name": "All Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2000,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Fetch results for successful sessions and retain a sentinel for an\n// all-failed run so report generation still executes.\nconst completed = $input.first().json.sessionStatuses\n  .filter(session => session.status === 'completed')\n  .map(session => ({ ...session, skipResultFetch: false }));\nreturn completed.length ? completed : [{ skipResultFetch: true }];"
      },
      "id": "scheduled-result-requests",
      "name": "Prepare Result Requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "scheduled-result-fetch-required",
              "leftValue": "={{ $json.skipResultFetch }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "scheduled-result-fetch-guard",
      "name": "Has Successful Results?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2440,
        200
      ]
    },
    {
      "parameters": {
        "url": "=http://backend:8000/research/{{ $json.sessionId }}/result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $env.BACKEND_N8N_API_TOKEN }}"}]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        }
      },
      "id": "g3h4i5j6-k7l8-m9n0-o1p2-q3r4s5t6u7v8",
      "name": "Get Research Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        2660,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Process terminal results for storage, including partial/all-failed runs.\nconst analysis = $('Analyze Scheduled Status').last().json;\nconst tracked = analysis.sessionStatuses;\nconst first = tracked[0] || {};\nconst results = $input.all()\n  .map(item => item.json)\n  .filter(item => !item.skipResultFetch);\nconst processedResults = results.map(result => {\n  const original = tracked.find(session => session.sessionId === result.session_id) || {};\n  return {\n    sessionId: result.session_id,\n    query: original.query,\n    priority: original.priority,\n    title: result.title,\n    summary: result.summary,\n    wordCount: result.content ? result.content.length : 0,\n    sourceCount: result.sources ? result.sources.length : 0,\n    completedAt: result.created_at\n  };\n});\nconst totalWords = processedResults.reduce((sum, item) => sum + item.wordCount, 0);\n\nreturn [{\n  batchId: first.batchId,\n  reportType: 'scheduled_research',\n  generatedAt: new Date().toISOString(),\n  executionSummary: {\n    totalQueries: tracked.length,\n    completedSuccessfully: analysis.completedCount,\n    failed: analysis.failedCount,\n    averageWordCount: processedResults.length ? totalWords / processedResults.length : 0,\n    totalSources: processedResults.reduce((sum, item) => sum + item.sourceCount, 0)\n  },\n  results: processedResults,\n  failures: tracked.filter(item => item.status !== 'completed'),\n  metadata: {\n    scheduleType: first.scheduleType,\n    startedAt: first.startedAt,\n    processingTime: first.startedAt ? Date.now() - new Date(first.startedAt).getTime() : null\n  }\n}];"
      },
      "id": "h5i6j7k8-l9m0-n1o2-p3q4-r5s6t7u8v9w0",
      "name": "Generate Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        200
      ]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "scheduled-wait-retry",
      "name": "Wait and Retry Scheduled",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        2220,
        450
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/storage/upload?bucket=research-reports",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $env.BACKEND_N8N_API_TOKEN }}"}]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "report"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "i7j8k9l0-m1n2-o3p4-q5r6-s7t8u9v0w1x2",
      "name": "Save Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        3320,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Convert report to binary data for storage\nconst report = $input.first().json;\nconst reportJson = JSON.stringify(report, null, 2);\nconst filename = `research_report_${report.batchId}.json`;\n\n// Create binary data\nconst binaryData = Buffer.from(reportJson, 'utf8');\n\nreturn {\n  json: {\n    filename: filename,\n    contentType: 'application/json',\n    size: binaryData.length\n  },\n  binary: {\n    report: {\n      data: binaryData.toString('base64'),\n      mimeType: 'application/json',\n      fileName: filename\n    }\n  }\n};"
      },
      "id": "j9k0l1m2-n3o4-p5q6-r7s8-t9u0v1w2x3y4",
      "name": "Prepare Report File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3100,
        200
      ]
    }
  ],
