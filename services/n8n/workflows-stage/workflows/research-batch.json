{
  "name": "Batch Research Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "authentication": "headerAuth",
        "path": "batch-research",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-e5f6-g7h8-i9j0-k1l2m3n4o5p6",
      "name": "Batch Research Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "atlas-webhook-header-auth",
          "name": "Atlas Webhook Header Auth"
        }
      },
      "webhookId": "batch-research"
    },
    {
      "parameters": {
        "jsCode": "// Process batch research request and carry batch state on every item.\nconst webhook = $input.first().json;\nconst request = webhook.body || webhook;\nconst queries = request.queries ?? [];\nconst config = request.config ?? {};\n\nif (!Array.isArray(queries) || queries.length === 0) {\n  throw new Error('queries array is required and must not be empty');\n}\nif (queries.length > 25) {\n  throw new Error('queries array must contain at most 25 entries');\n}\nif (!config || typeof config !== 'object' || Array.isArray(config)) {\n  throw new Error('config must be an object');\n}\n\nconst allowedSearchApis = new Set(['duckduckgo', 'searxng']);\nconst batchId = Date.now().toString();\nconst startedAt = new Date().toISOString();\nreturn queries.map((entry, index) => {\n  const query = typeof entry === 'string' ? { query: entry } : entry;\n  if (!query || typeof query !== 'object' || Array.isArray(query)) {\n    throw new Error(`query ${index} must be a string or object`);\n  }\n  if (typeof query.query !== 'string' || !query.query.trim() || query.query.length > 4000) {\n    throw new Error(`query ${index} text must contain 1 to 4000 characters`);\n  }\n  const maxLoops = query.max_loops ?? config.max_loops ?? 3;\n  if (!Number.isInteger(maxLoops) || maxLoops < 1 || maxLoops > 10) {\n    throw new Error(`query ${index} max_loops must be an integer from 1 to 10`);\n  }\n  const searchApi = query.search_api ?? config.search_api ?? 'searxng';\n  if (!allowedSearchApis.has(searchApi)) {\n    throw new Error(`query ${index} search_api must be duckduckgo or searxng`);\n  }\n  return {\n    batchId,\n    totalQueries: queries.length,\n    startedAt,\n    index,\n    query: query.query,\n    max_loops: maxLoops,\n    search_api: searchApi,\n    user_id: query.user_id ?? config.user_id ?? null\n  };\n});"
      },
      "id": "b3c4d5e6-f7g8-h9i0-j1k2-l3m4n5o6p7q8",
      "name": "Process Batch Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/research/start",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $env.BACKEND_N8N_API_TOKEN }}"}]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.query }}"
            },
            {
              "name": "max_loops",
              "value": "={{ $json.max_loops }}"
            },
            {
              "name": "search_api",
              "value": "={{ $json.search_api }}"
            },
            {
              "name": "user_id",
              "value": "={{ $json.user_id }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "c5d6e7f8-g9h0-i1j2-k3l4-m5n6o7p8q9r0",
      "name": "Start Individual Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Restore each request item after HTTP Request replaced it with the response.\nconst requests = $('Process Batch Request').all();\nreturn $input.all().map((item, index) => {\n  const request = requests[index]?.json || {};\n  return {\n    ...request,\n    sessionId: item.json.session_id,\n    status: item.json.status || 'running'\n  };\n});"
      },
      "id": "d7e8f9g0-h1i2-j3k4-l5m6-n7o8p9q0r1s2",
      "name": "Collect Session IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "amount": 45,
        "unit": "seconds"
      },
      "id": "e9f0g1h2-i3j4-k5l6-m7n8-o9p0q1r2s3t4",
      "name": "Wait for All Processing",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Recreate status-check items from the durable upstream node output.\nreturn $('Collect Session IDs').all().map(item => ({ ...item.json }));"
      },
      "id": "f1g2h3i4-j5k6-l7m8-n9o0-p1q2r3s4t5u6",
      "name": "Prepare Status Checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "url": "=http://backend:8000/research/{{ $json.sessionId }}/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $env.BACKEND_N8N_API_TOKEN }}"}]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "g3h4i5j6-k7l8-m9n0-o1p2-q3r4s5t6u7v8",
      "name": "Check All Statuses",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1560,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Join status responses back to their request items by session id.\nconst sessions = $('Collect Session IDs').all().map(item => item.json);\nconst sessionStatuses = $input.all().map(item => {\n  const response = item.json;\n  const original = sessions.find(session => session.sessionId === response.session_id) || {};\n  return {\n    ...original,\n    sessionId: response.session_id || original.sessionId,\n    status: response.status,\n    errorMessage: response.error_message || null\n  };\n});\nconst completedCount = sessionStatuses.filter(item => item.status === 'completed').length;\nconst failedCount = sessionStatuses.filter(item => ['failed', 'cancelled'].includes(item.status)).length;\nconst first = sessions[0] || {};\n\nreturn [{\n  batchId: first.batchId,\n  totalQueries: first.totalQueries || sessions.length,\n  startedAt: first.startedAt,\n  allCompleted: completedCount + failedCount === sessionStatuses.length,\n  completedCount,\n  failedCount,\n  sessionStatuses\n}];"
      },
      "id": "h5i6j7k8-l9m0-n1o2-p3q4-r5s6t7u8v9w0",
      "name": "Analyze Batch Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "i7j8k9l0-m1n2-o3p4-q5r6-s7t8u9v0w1x2",
              "leftValue": "={{ $json.allCompleted }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "j9k0l1m2-n3o4-p5q6-r7s8-t9u0v1w2x3y4",
      "name": "All Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2000,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Get results only for sessions that completed successfully. Keep one\n// sentinel item when every session failed so the workflow can still respond.\nconst completed = $input.first().json.sessionStatuses\n  .filter(session => session.status === 'completed')\n  .map(session => ({ ...session, skipResultFetch: false }));\nreturn completed.length ? completed : [{ skipResultFetch: true }];"
      },
      "id": "k1l2m3n4-o5p6-q7r8-s9t0-u1v2w3x4y5z6",
      "name": "Prepare Result Requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "result-fetch-required",
              "leftValue": "={{ $json.skipResultFetch }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "result-fetch-guard",
      "name": "Has Successful Results?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2440,
        200
      ]
    },
    {
      "parameters": {
        "url": "=http://backend:8000/research/{{ $json.sessionId }}/result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $env.BACKEND_N8N_API_TOKEN }}"}]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "l3m4n5o6-p7q8-r9s0-t1u2-v3w4x5y6z7a8",
      "name": "Get All Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        2660,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Format final batch results from the latest status analysis.\nconst analysis = $('Analyze Batch Status').last().json;\nconst results = $input.all()\n  .map(item => item.json)\n  .filter(item => !item.skipResultFetch);\nreturn [{\n  batchId: analysis.batchId,\n  status: analysis.failedCount > 0 ? 'completed_with_errors' : 'completed',\n  summary: {\n    totalQueries: analysis.totalQueries,\n    completedSuccessfully: analysis.completedCount,\n    failed: analysis.failedCount,\n    successRate: analysis.totalQueries ? analysis.completedCount / analysis.totalQueries : 0\n  },\n  startedAt: analysis.startedAt,\n  completedAt: new Date().toISOString(),\n  results,\n  failures: analysis.sessionStatuses.filter(item => item.status !== 'completed')\n}];"
      },
      "id": "m5n6o7p8-q9r0-s1t2-u3v4-w5x6y7z8a9b0",
      "name": "Format Batch Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        200
      ]
    },
    {
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      },
      "id": "n7o8p9q0-r1s2-t3u4-v5w6-x7y8z9a0b1c2",
      "name": "Wait and Retry Batch",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        2220,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "id": "o9p0q1r2-s3t4-u5v6-w7x8-y9z0a1b2c3d4",
      "name": "Return Batch Results",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        3100,
        200
      ]
    }
  ],
