REDPANDA_SOURCE=disabled

# Image references
# Pinned to the latest Redpanda 26.1.x maintenance release verified for multi-arch Docker images.
REDPANDA_IMAGE=docker.redpanda.com/redpandadata/redpanda:v26.1.12
# Pinned to the latest Redpanda Console 3.8.x release.
REDPANDA_CONSOLE_IMAGE=docker.redpanda.com/redpandadata/console:v3.8.0

# Host port for the Redpanda Kafka API external listener (in-container 19092).
REDPANDA_KAFKA_PORT=63010
# Host port for Redpanda Console (in-container 8080).
REDPANDA_CONSOLE_PORT=63011
# Comma-separated Kafka topics created idempotently by redpanda-init.
REDPANDA_DEMO_TOPICS=atlas_stream_events
# (auto-managed)
REDPANDA_SCALE=
# (auto-managed)
REDPANDA_INIT_SCALE=
# (auto-managed)
REDPANDA_CONSOLE_SCALE=
# In-network Kafka bootstrap servers for Atlas services.
# (auto-managed)
REDPANDA_BROKERS=
# Spark Structured Streaming Kafka bootstrap servers; blank when Redpanda is disabled.
# (auto-managed)
SPARK_KAFKA_BOOTSTRAP_SERVERS=

