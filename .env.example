# ============================================================================
# GENERATED FILE — DO NOT EDIT BY HAND
#
# This .env.example is produced by bootstrapper/services/env_assembler.py
# from services/<name>/service.yml manifests. To change a default, edit the
# relevant manifest and re-run `python -m services.env_assembler` from the
# bootstrapper directory. `./start.sh` does NOT regenerate this file -- it
# backfills your own .env from whatever this file already contains.
#
# Variables flagged `auto-managed` are computed at runtime by the bootstrapper
# from SOURCE values and are intentionally emitted without a default here.
# Security upgrade: existing .env files with HOST_BIND_IP= are upgraded by
# ./start.sh's blank-value backfill to the manifest-owned loopback default.
# ============================================================================

# ──────────────────────────────────────────────────────────────────────────
# agents: Apache Airflow (DAG orchestrator)  (services/airflow/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
AIRFLOW_SOURCE=disabled

# Image references
AIRFLOW_IMAGE=apache/airflow:3.3.2

# Host port for the Airflow Web UI + REST API (in-container 8080).
AIRFLOW_PORT=63070
# Postgres role that owns the airflow metadata database on supabase-db. Supabase DB init creates it; Airflow connects with it and AIRFLOW_DB_PASSWORD.
AIRFLOW_DB_USER=airflow
# Auto-generated by bootstrapper. Postgres role for the Airflow metadata DB.
# (secret)
AIRFLOW_DB_PASSWORD=atlas-db-password
# Bootstrapper-synchronized percent-encoded AIRFLOW_DB_USER for DSN userinfo.
AIRFLOW_DB_USER_URI=airflow
# Bootstrapper-synchronized percent-encoded AIRFLOW_DB_PASSWORD for DSN userinfo.
# (secret)
AIRFLOW_DB_PASSWORD_URI=atlas-db-password
# Read-only login seeded into the postgres_supabase Airflow Connection.
AIRFLOW_ATLAS_DB_USER=atlas_airflow_reader
# Auto-generated password for Airflow DAGs' read-only Atlas database connection.
# (secret)
AIRFLOW_ATLAS_DB_PASSWORD=atlas-db-password
# Auto-generated. Fernet key for encrypting Connection passwords.
# (secret)
AIRFLOW_FERNET_KEY=
# Auto-generated. Mapped to AIRFLOW__API__SECRET_KEY ([api] secret_key) in every Airflow container. Execution API JWTs use AIRFLOW_JWT_SECRET instead.
# (secret)
AIRFLOW_SECRET_KEY=
# Auto-generated. Mapped to AIRFLOW__API_AUTH__JWT_SECRET; signs Execution API and /api/v2/ auth-token JWTs. Every Airflow process must share it, or cross-process verification fails with 403 InvalidSignatureError. Kept on warm restart.
# (secret)
AIRFLOW_JWT_SECRET=
# Auto-generated. Admin login. Username is hardcoded 'admin'.
# (secret)
AIRFLOW_ADMIN_PASSWORD=
# Set by ./start.sh from AIRFLOW_SOURCE; do not edit. 1 runs airflow-webserver (UI and REST API), 0 does not.
# (auto-managed)
AIRFLOW_WEBSERVER_SCALE=
# Set by ./start.sh from AIRFLOW_SOURCE; do not edit. 1 runs airflow-scheduler, 0 does not.
# (auto-managed)
AIRFLOW_SCHEDULER_SCALE=
# Set by ./start.sh from AIRFLOW_SOURCE; do not edit. 1 runs airflow-dag-processor. Airflow 3 needs it: it parses DAG files into the metadata DB, which the scheduler does not do.
# (auto-managed)
AIRFLOW_DAG_PROCESSOR_SCALE=
# Set by ./start.sh from AIRFLOW_SOURCE; do not edit. 1 runs the one-shot airflow-init container at stack start, 0 does not.
# (auto-managed)
AIRFLOW_INIT_SCALE=
# Container memory limit for airflow-webserver (deploy.resources.limits.memory). The api-server process is Python + Flask/FAB; 2 g is comfortable on a 32 GB host and prevents runaway memory from large DAG list pages.
AIRFLOW_WEBSERVER_MEMORY_LIMIT=2g
# Container CPU limit for airflow-webserver (deploy.resources.limits.cpus). 1.0 core is ample for the API/UI server under typical load.
AIRFLOW_WEBSERVER_CPU_LIMIT=1.0
# Container memory limit for airflow-scheduler (deploy.resources.limits.memory). The LocalExecutor scheduler forks task processes in-process; 2 g caps runaway task forking.
AIRFLOW_SCHEDULER_MEMORY_LIMIT=2g
# Container CPU limit for airflow-scheduler (deploy.resources.limits.cpus). 1.0 core is sufficient for LocalExecutor task scheduling on a dev/staging host.
AIRFLOW_SCHEDULER_CPU_LIMIT=1.0
# Container memory limit for airflow-dag-processor (deploy.resources.limits.memory). DAG parsing is Python-heavy but short-lived per cycle; 2 g prevents unbounded growth from parsing pathological DAG files.
AIRFLOW_DAG_PROCESSOR_MEMORY_LIMIT=2g
# Container CPU limit for airflow-dag-processor (deploy.resources.limits.cpus). 1.0 core covers the periodic DAG file parsing cycle.
AIRFLOW_DAG_PROCESSOR_CPU_LIMIT=1.0

# ──────────────────────────────────────────────────────────────────────────
# media: Asset Baker (Blender HP→LP bake)  (services/asset-baker/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container-cpu | disabled
ASSET_BAKER_SOURCE=disabled

# Image references
# Base image; the Dockerfile downloads a pinned headless Blender (ASSET_BAKER_BLENDER_VERSION) on top.
ASSET_BAKER_IMAGE=python:3.12.9-slim

# Host port for the asset-baker API (in-container listen port is 8096).
ASSET_BAKER_PORT=63052
# Set by ./start.sh from ASSET_BAKER_SOURCE; do not edit. 1 runs asset-baker (container-cpu), 0 does not.
# (auto-managed)
ASSET_BAKER_SCALE=
# Platform the asset-baker image is built and run for. The Blender build is x86_64-only, so arm64 hosts (Apple Silicon) run it under emulation; keep linux/amd64.
ASSET_BAKER_PLATFORM=linux/amd64
# In-network URL for the asset-baker API.
# (auto-managed)
ASSET_BAKER_ENDPOINT=
# Auto-generated bearer token required by all Asset Baker data and processing routes; /health remains unauthenticated.
# (secret)
ASSET_BAKER_API_TOKEN=
# Optional comma- or space-separated reference-route bucket allowlist; blank follows MINIO_BUCKET_ASSET_INPUTS.
ASSET_BAKER_ALLOWED_INPUT_BUCKETS=
# Pinned headless Blender version (>= 4.3) downloaded into the asset-baker image. Blender bundles its own Python + numpy for the bake script.
ASSET_BAKER_BLENDER_VERSION=4.3.2
# SHA-256 checksum verified before extracting the pinned Blender archive. Update it with ASSET_BAKER_BLENDER_VERSION from Blender's published checksum file.
ASSET_BAKER_BLENDER_SHA256=4da1c956673c0485e63054e563ee69198cc8f80d8157dd7592dffc8a6a5592e6
# Local artifact cache used when MinIO upload is disabled or for direct downloads.
ASSET_BAKER_ARTIFACT_DIR=/data/artifacts
# When true, baked LP GLBs + textures are written to MinIO using content-addressed keys.
ASSET_BAKER_MINIO_ENABLED=true
# MinIO bucket for baked LP GLB + texture outputs.
ASSET_BAKER_MINIO_BUCKET=asset-baker
# In-network MinIO S3 API endpoint used by the worker.
# (auto-managed)
ASSET_BAKER_MINIO_ENDPOINT=
# Optional MinIO access key override. Empty uses the generated asset-baker scoped MinIO account.
# (secret)
ASSET_BAKER_MINIO_ACCESS_KEY=
# Optional MinIO secret key override. Empty uses the generated asset-baker scoped MinIO account.
# (secret)
ASSET_BAKER_MINIO_SECRET_KEY=
# Default low-poly triangle budget the decimate stage targets (overridable per request).
ASSET_BAKER_TARGET_TRIS=39000
# Default baked BaseColor/Normal texture resolution (square). 2k measured 30–200 s/asset on CPU; overridable per request.
ASSET_BAKER_TEX_SIZE=2048
# Canonical max-dimension (units) each mesh is scaled to before remesh so the relative voxel/ray heuristics are stable regardless of the raw GLB import scale.
ASSET_BAKER_CANONICAL_SIZE=4.0
# Mean-brightness QA gate: a baked BaseColor whose mean < this is a silently-failed (black) bake and is refused with a non-zero result.
ASSET_BAKER_BRIGHTNESS_MIN=0.05
# Hard wall-clock ceiling for a single bake subprocess; exceeded bakes are killed and reported as timeout.
ASSET_BAKER_TIMEOUT_SECONDS=600
# Maximum accepted GLB input size (MiB). Larger uploads/refs are rejected before a Blender process is spawned.
ASSET_BAKER_MAX_UPLOAD_MB=200
# Maximum concurrent bake subprocesses. Default 1 — a single Cycles bake saturates CPU and concurrent bakes are net-negative.
ASSET_BAKER_CONCURRENCY=1

# ──────────────────────────────────────────────────────────────────────────
# media: Asset Worker (glTF post-processing)  (services/asset-worker/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
ASSET_WORKER_SOURCE=disabled

# Image references
ASSET_WORKER_IMAGE=python:3.12.9-slim

# Host port for the asset-worker API (in-container listen port is 8095).
ASSET_WORKER_PORT=63053
# Set by ./start.sh from ASSET_WORKER_SOURCE; do not edit. 1 runs asset-worker (container), 0 does not.
# (auto-managed)
ASSET_WORKER_SCALE=
# In-network URL for the asset-worker API.
# (auto-managed)
ASSET_WORKER_ENDPOINT=
# Auto-generated bearer token required by all Asset Worker data and processing routes; /health remains unauthenticated.
# (secret)
ASSET_WORKER_API_TOKEN=
# Optional comma- or space-separated reference-route bucket allowlist; blank follows MINIO_BUCKET_ASSET_INPUTS.
ASSET_WORKER_ALLOWED_INPUT_BUCKETS=
# Expected pinned @gltf-transform/cli lock version; overrides must match package.json and package-lock.json.
ASSET_WORKER_GLTF_TRANSFORM_VERSION=4.5.1
# Maximum GLB upload or MinIO reference size in MiB. Input is streamed and rejected before transformation when this limit is exceeded.
ASSET_WORKER_MAX_UPLOAD_MB=200
# Per-command timeout for gltf-transform inspect, validate, and optimize subprocesses.
ASSET_WORKER_TIMEOUT_SECONDS=300
# Maximum concurrent glTF mutation requests; saturated workers reject new work with HTTP 429 before request-body parsing or object-store fetch.
ASSET_WORKER_CONCURRENCY=1
# Local artifact cache used when MinIO upload is disabled or for direct downloads.
ASSET_WORKER_ARTIFACT_DIR=/data/artifacts
# When true, optimized GLBs are written to MinIO using content-addressed keys.
ASSET_WORKER_MINIO_ENABLED=true
# MinIO bucket for optimized GLB outputs.
ASSET_WORKER_MINIO_BUCKET=asset-worker
# In-network MinIO S3 API endpoint used by the worker.
# (auto-managed)
ASSET_WORKER_MINIO_ENDPOINT=
# Optional MinIO access key override. Empty uses the generated asset-worker scoped MinIO account.
# (secret)
ASSET_WORKER_MINIO_ACCESS_KEY=
# Optional MinIO secret key override. Empty uses the generated asset-worker scoped MinIO account.
# (secret)
ASSET_WORKER_MINIO_SECRET_KEY=

# ──────────────────────────────────────────────────────────────────────────
# apps: Backend API (FastAPI)  (services/backend/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Image references
BACKEND_IMAGE=python:3.12.14-bookworm@sha256:581429e3df12d76e6af4be5ab7d0e7fc2013eb57dc23d2de691411c8efdbb970

# Scoped PostgreSQL login for Backend and its Celery worker.
BACKEND_DB_USER=atlas_backend
# Auto-generated password for the scoped Backend database role.
# (secret)
BACKEND_DB_PASSWORD=atlas-db-password
# Bootstrapper-synchronized percent-encoded BACKEND_DB_USER for DSN userinfo.
BACKEND_DB_USER_URI=atlas_backend
# Bootstrapper-synchronized percent-encoded BACKEND_DB_PASSWORD for DSN userinfo.
# (secret)
BACKEND_DB_PASSWORD_URI=atlas-db-password
# Adaptive core service; always container. Single-option.
BACKEND_SOURCE=container
# Host port that publishes the Backend API (in-container port 8000).
BACKEND_PORT=63093
# Always 1 (BACKEND_SOURCE is single-valued).
# (auto-managed)
BACKEND_SCALE=
# Maximum accepted /storage/upload body size in bytes before the backend returns 413.
MAX_UPLOAD_BYTES=104857600
# Maximum input or generated-image bytes accepted by the Backend's ComfyUI bridge before it aborts the transfer.
COMFYUI_MAX_IMAGE_BYTES=20971520
# Comma-separated exact HTTPS origins allowed for remote ComfyUI init-image URLs. Blank rejects all remote URLs; data URIs remain available.
COMFYUI_INIT_IMAGE_TRUSTED_ORIGINS=
# End-to-end deadline in seconds for synchronous ComfyUI generation and workflow requests. The Backend poller and bundled Open WebUI tool share this default.
COMFYUI_COMPLETION_TIMEOUT_SECONDS=300
# Maximum bytes loaded from any single mounted or MinIO RAG corpus file. Oversize files fail ingestion before unbounded allocation.
RAG_INGESTION_MAX_FILE_BYTES=104857600
# Maximum aggregate bytes loaded by one RAG corpus discovery pass across mounted or MinIO files.
RAG_INGESTION_MAX_CORPUS_BYTES=1073741824
# Maximum number of files accepted in one mounted or MinIO RAG corpus discovery pass.
RAG_INGESTION_MAX_FILES=10000
# Container path under which operator-provided read-only RAG corpus mounts are resolved. Mount the same path into Backend and Celery worker when asynchronous ingestion is enabled.
RAG_INGESTION_CORPUS_ROOT=/app/corpus
# Non-empty Chonkie embedding model reference used by semantic chunking. Blank values use the bundled default. Shared by Backend and Celery ingestion workers.
CHONKIE_SEMANTIC_EMBEDDING_MODEL=minishlab/potion-base-32M
# Finite per-request timeout in seconds for LightRAG pipeline-status polling. Values must be greater than 0 and no greater than 3600; invalid values use 30 seconds. Shared by Backend and Celery ingestion workers.
LIGHTRAG_PIPELINE_STATUS_TIMEOUT_SECONDS=30
# Redis retention in seconds for RAG ingestion records and idempotency keys. Values must be from 60 through 31536000 (one year); invalid values use the seven-day default. Shared by Backend and Celery ingestion workers.
RAG_INGESTION_TTL_SECONDS=604800
# Renewable execution-ownership lease for RAG ingestion workers. Must be an integer from 10 through 300; duplicate deliveries retry until the active owner completes, an exact-owner recovery claim succeeds, or the lease expires.
RAG_INGESTION_EXECUTION_LEASE_SECONDS=30
# Shared operation-state mode: 'redis' (durable, multi-process default) or 'memory' (explicit single-process testing/ephemeral mode). Redis outages fail stateful routes with HTTP 503; they never trigger an in-memory fallback.
BACKEND_STATE_STORE_MODE=redis
# Maximum age in seconds for pending research work or a running session heartbeat before the Backend atomically marks the abandoned session failed.
RESEARCH_SESSION_LEASE_SECONDS=300
# Maximum research sessions admitted concurrently per Backend process. Excess start requests fail before database work with HTTP 429.
RESEARCH_MAX_CONCURRENT=4
# Maximum /api/chunk and /api/rag/evaluate jobs the Backend runs at once, on a pool of its own so they cannot starve other routes. Further calls get HTTP 503 with Retry-After until a slot frees.
BACKEND_HEAVY_WORK_CONCURRENCY=4
# Seconds a /api/chunk or /api/rag/evaluate call waits for its result before answering HTTP 504. The job keeps its concurrency slot until its thread actually finishes.
BACKEND_HEAVY_WORK_TIMEOUT_SECONDS=600
# Minimum connections kept warm in the Backend's shared asyncpg pool. Short-lived DB operations draw from it instead of opening a new connection; long-hold paths (memory vector reconcile) keep dedicated connections.
BACKEND_PG_POOL_MIN=1
# Maximum connections the Backend's shared asyncpg pool opens per database URL. Concurrent short-lived DB operations beyond this queue for a free slot rather than over-subscribing Postgres.
BACKEND_PG_POOL_MAX=10
# Comma-separated Supabase Storage bucket allowlist accepted by /storage/upload.
BACKEND_STORAGE_ALLOWED_BUCKETS=default
# Atlas storage bucket the media gateway hosts image_to_3d inputs in when a provider (e.g. Tripo) rejects data-URI inputs. Objects are written under the media-inputs/ prefix.
BACKEND_MEDIA_INPUT_BUCKET=default
# Optional public base URL for hosted media inputs. When set, hosted image_to_3d input URLs are <base>/<bucket>/<key>, so the provider's cloud can fetch them through a reachable ingress. Empty uses the storage client's public URL.
BACKEND_MEDIA_INPUT_PUBLIC_BASE_URL=
# Maximum POST /media/generate request body size in bytes. Oversized declared and streamed bodies are rejected with HTTP 413 before route parsing.
MEDIA_REQUEST_MAX_BYTES=41943040
# Maximum decoded image data-URI size in bytes, including conditioned output. Oversized base64 payloads are rejected before decoding.
MEDIA_INPUT_MAX_BYTES=26214400
# Maximum decoded or conditioned image pixel count. Dimensions are checked before full Pillow conversion to bound decompression and canvas memory.
MEDIA_INPUT_MAX_PIXELS=40000000
# Enables media spend accounting and budget enforcement. When off, ordinary operations record no spend rows and enforce no caps; ambiguous FAL submissions still create a recovery row.
MEDIA_BUDGET_ENABLED=false
# Ledger/recovery store: 'postgres' (durable, media_spend_ledger table) or 'memory' (process-local, non-durable — testing/ephemeral). Ambiguous FAL submissions use it for recovery even when budget enforcement is disabled.
MEDIA_BUDGET_STORE=postgres
# Currency label recorded on media spend ledger rows.
MEDIA_BUDGET_CURRENCY=USD
# Default per-consumer/project spend cap in USD. Empty = no default cap (ledger records without hard-stop). Per-consumer overrides go in MEDIA_BUDGET_CONSUMER_CAPS.
MEDIA_BUDGET_DEFAULT_USD=
# Optional JSON map of per-scope caps, keyed by 'consumer' or 'consumer:project', e.g. {"rag-showcase":25,"rag-showcase:demo":5}. Overrides MEDIA_BUDGET_DEFAULT_USD for matching scopes. A 'consumer' key still caps each project separately, and user callers choose the project name, so it is not a per-user total.
MEDIA_BUDGET_CONSUMER_CAPS=
# Comma-separated media providers to kill-switch off (e.g. 'fal', 'comfyui'). A disabled provider hard-stops its own submissions (/media/generate, /comfyui/generate and /comfyui/workflow, whether or not MEDIA_BUDGET_ENABLED is set) without downing the gateway or other providers.
MEDIA_DISABLED_PROVIDERS=
# When false (default), a budgeted submission for a model with no known cost is rejected rather than billed an unknown amount (never silently $0). Set true to allow unknown-cost submissions under a cap.
MEDIA_BUDGET_ALLOW_UNKNOWN_COST=false
# Optional retention window in days for media spend ledger rows; empty keeps rows indefinitely (no pruning). When set, an hourly background sweep prunes rows older than the window.
MEDIA_BUDGET_RETENTION_DAYS=
# Redis retention in seconds for hosted media operation state. The default keeps terminal results available for seven days across Backend replicas and restarts.
MEDIA_OPERATION_TTL_SECONDS=604800
# Maximum media ledger intents loaded in one bounded Redis recovery page. Must be an integer from 1 through 500.
MEDIA_LEDGER_RECOVERY_BATCH_SIZE=100
# Maximum bounded media ledger pages processed per 30-second recovery poll. Must be an integer from 1 through 50; the cursor resumes on the next poll.
MEDIA_LEDGER_RECOVERY_MAX_CYCLES=4
# Comma-separated browser origins accepted by the backend CORS middleware. Default preserves local-development permissiveness. Requests through Kong are also limited to local origins plus KONG_CORS_EXTRA_ORIGINS.
BACKEND_CORS_ORIGINS=*
# Optional regex accepted by the backend CORS middleware for wildcard subdomain policies.
BACKEND_CORS_ALLOW_ORIGIN_REGEX=
# Opt-in uvicorn --reload for live development. Off by default: with backend_plugins bind-mounted, host-side git churn in the plugin tree would restart or crash-loop the backend. Plugins install at boot, so recreate the backend to apply plugin changes.
BACKEND_DEV_RELOAD=false
# Default gateway authentication for the api.localhost backend route: disabled (default, local development) or key-auth (requires an apikey header). A backend plugin's plugin.yml auth: setting (open or key-auth) overrides it per route prefix.
BACKEND_KONG_AUTH=disabled
# Auto-generated key accepted by Kong when BACKEND_KONG_AUTH=key-auth. Send as `apikey: <value>`.
# (secret)
BACKEND_KONG_API_KEY=
# Application identity boundary for backend routes: required (default) accepts Supabase user JWTs or the trusted internal-service token; disabled is an explicit emergency rollback mode.
BACKEND_IDENTITY_AUTH=required
# Auto-generated full-operator bearer token. Reserve for trusted administration; first-party services use narrower caller tokens.
# (secret)
BACKEND_INTERNAL_API_TOKEN=
# Auto-generated n8n bearer accepted only by the research, memory-automation, legacy ComfyUI, and storage-upload routes used by bundled workflows.
# (secret)
BACKEND_N8N_API_TOKEN=
# Auto-generated bearer token exposed to JupyterHub and accepted only by stateless backend document extraction, chunking, and RAG evaluation routes.
# (secret)
BACKEND_NOTEBOOK_API_TOKEN=
# Auto-generated Open WebUI bearer accepted only by memory and legacy ComfyUI routes used by bundled server-side tools and functions.
# (secret)
BACKEND_OPEN_WEBUI_API_TOKEN=
# Timeout in seconds for `pip install` of backend plugin requirements (plugin_seam) at startup. The install runs at backend import time, so an unbounded hang would block startup; raise for slow networks.
BACKEND_PLUGINS_PIP_TIMEOUT_SECONDS=300
# Writable directory for plugin requirements (`pip --target`), prepended to sys.path before plugins load; site-packages is root-owned. If it cannot be created, pip installs untargeted. Emptied at each start; a custom directory only once it has the .atlas-plugin-site marker.
BACKEND_PLUGINS_SITE_DIR=/tmp/atlas-plugins-site
# Enables the Backend memory service in backend and celery-worker. false makes memory operations fail with "LangMem memory service is disabled".
LANGMEM_ENABLED=true
# Default memory namespace (passed as LANGMEM_NAMESPACE to backend and celery-worker). A request that names its own namespace overrides it.
LANGMEM_MEMORY_NAMESPACE=default
# Reserved — not yet honored. Memory consolidation currently runs only
# on demand via POST /memory/consolidate; there is no background
# scheduler, so changing this value has no effect today.
LANGMEM_AUTO_CONSOLIDATE=true
# Reserved — not yet honored (see LANGMEM_AUTO_CONSOLIDATE). Interval in
# seconds a future auto-consolidation scheduler would use.
LANGMEM_CONSOLIDATION_INTERVAL=86400
# Maximum active memory facts per user in backend and celery-worker. Extraction stops storing new facts at the limit, consolidation deactivates the oldest excess facts, and a restore beyond it fails with 409.
LANGMEM_MAX_FACTS_PER_USER=1000
# LiteLLM model id (empty = highest-priority active content model resolved by model_resolver from YAML catalogs + env).
LANGMEM_EXTRACTION_MODEL=
# Optional LiteLLM embedding model id. Empty falls back to LITELLM_EMBEDDING_MODEL.
LANGMEM_EMBEDDING_MODEL=
# Validated output dimension shared by the selected LangMem embedding model, Backend pgvector queries, and the Supabase memory schema migration. Curated wizard selections derive this from services/*/models.yaml; custom models must declare it explicitly (1..4000, the pgvector halfvec HNSW limit).
LANGMEM_EMBEDDING_DIM=768
# Disabled-by-default backend-only Graphiti temporal graph memory experiment. Does not expose Graphiti to agents or run a Graphiti service.
GRAPHITI_ENABLED=false
# Prefix for backend Graphiti group_id values. Final shape: atlas:<project>:backend:<namespace>:user:<uuid>.
GRAPHITI_GROUP_ID_PREFIX=atlas
# Default backend Graphiti namespace segment used when projecting selected LangMem facts/events.
GRAPHITI_DEFAULT_NAMESPACE=langmem
# Optional LiteLLM model id for Graphiti extraction. Empty falls back to LANGMEM_EXTRACTION_MODEL, then LITELLM_DEFAULT_MODEL.
GRAPHITI_LLM_MODEL=
# Optional LiteLLM embedding model id for Graphiti. Empty falls back to LANGMEM_EMBEDDING_MODEL, then LITELLM_EMBEDDING_MODEL.
GRAPHITI_EMBEDDING_MODEL=
# Must remain false for this backend-only evaluation; Hermes/OpenClaw exposure and Graphiti MCP are deferred.
GRAPHITI_EXPOSE_TO_AGENTS=false
# Optional LiteLLM model id for Backend Ragas evaluation. Empty falls back to LITELLM_DEFAULT_MODEL.
RAGAS_EVALUATOR_MODEL=
# Optional LiteLLM embedding model id for Backend Ragas answer-relevancy evaluation. Empty falls back to LITELLM_EMBEDDING_MODEL.
RAGAS_EMBEDDINGS_MODEL=
# Auto-generated bearer token required by every /api/ray/* route. Send as Authorization: Bearer <value>.
# (secret)
RAY_JOB_API_TOKEN=
# Opt-in for the backend rerank adapter route POST /lightrag/rerank. When true and TEI_RERANKER_SOURCE is enabled, LightRAG reranks through the adapter and consumer profiles may set enable_rerank=true. Direct LightRAG-to-TEI rerank is unsupported (payload shapes differ).
LIGHTRAG_RERANK_ADAPTER_ENABLED=false
# Auto-generated bearer token guarding the /lightrag/rerank adapter route. Handed to LightRAG as RERANK_BINDING_API_KEY so the two share one secret. Send as `Authorization: Bearer <value>`.
# (secret)
LIGHTRAG_RERANK_ADAPTER_TOKEN=
# Finite per-request timeout in seconds for /lightrag/rerank calls to TEI. Must be greater than 0 and no greater than 3600; invalid values fail Backend startup.
LIGHTRAG_RERANK_ADAPTER_TIMEOUT_SECONDS=30

# ──────────────────────────────────────────────────────────────────────────
# infra: Backup / restore (Postgres + consistent database snapshots -> S3)  (services/backup/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
BACKUP_SOURCE=disabled

# Image references
# Digest-pinned build base for pg_dump/pg_restore; its major version must be >= the supabase-db server (17.x), or pg_dump aborts. The image bakes exact OpenSSL and the pgsty mc RELEASE.2026-09-16T00-00-00Z, copied from the digest-pinned pgsty/mc image. The entrypoint verifies its checksum and version for amd64/arm64.
BACKUP_IMAGE=postgres:17.11-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24

# Target bucket for backups.
BACKUP_BUCKET=atlas-backups
# Credential/dependency mode: local uses on-stack MinIO and permits the documented MINIO_ROOT_* upgrade fallback; external requires dedicated BACKUP_S3_* credentials and has no MinIO runtime dependency.
BACKUP_S3_MODE=local
# S3 endpoint as a strict HTTP(S) origin: canonical DNS/IPv4 or bracketed IPv6, optional canonical port, and no userinfo/path/query/fragment. The default is on-stack MinIO.
BACKUP_S3_ENDPOINT=http://minio:9000
# Dedicated S3 access key. Required for external endpoints; local MinIO may fall back to MINIO_ROOT_USER for upgrade compatibility.
# (secret)
BACKUP_S3_ACCESS_KEY=
# Dedicated S3 secret key. Required for external endpoints; local MinIO may fall back to MINIO_ROOT_PASSWORD for upgrade compatibility.
# (secret)
BACKUP_S3_SECRET_KEY=
# S3 signing and bucket-creation region.
BACKUP_S3_REGION=us-east-1
# Optional S3 security token for temporary credentials.
# (secret)
BACKUP_S3_SESSION_TOKEN=
# Verify HTTPS certificates. false is valid only with an https endpoint and explicitly enables the MinIO client's insecure certificate mode.
BACKUP_S3_TLS_VERIFY=true
# Deprecated pre-M11 endpoint variable accepted only as a migration fallback when BACKUP_S3_ENDPOINT remains at its local default.
BACKUP_S3_ALIAS_URL=
# Positive per-command deadline in seconds for package install, database, archive, and S3 operations.
BACKUP_COMMAND_TIMEOUT_SECONDS=900
# Finite active-restore deadline; must exceed BACKUP_COMMAND_TIMEOUT_SECONDS. Hard-kill grace covers three bounded commands plus 60 seconds for compensation and exact lock cleanup.
BACKUP_RESTORE_GLOBAL_TIMEOUT_SECONDS=28800
# Required operator-supplied 64-hex HMAC-SHA-256 key for trusted backup manifests; preserve it outside the backup bucket for disaster recovery.
# (secret)
BACKUP_MANIFEST_HMAC_KEY=
# Required stable operator-supplied deployment identity bound into every trusted backup manifest.
BACKUP_DEPLOYMENT_ID=
# Finite maximum PostgreSQL dump size accepted by both backup production and bounded restore download.
BACKUP_MAX_POSTGRES_DUMP_BYTES=10737418240
# Maximum newest completion markers inspected by latest restore; use an exact BACKUP_TIMESTAMP for older backups.
BACKUP_RESTORE_MAX_CANDIDATES=100
# Capture Neo4j and Weaviate using their consistency-safe contracts. Run through services/backup/run-consistent-backup.sh so Neo4j is quiesced first.
BACKUP_DATABASES=true
# Bounded host-side stop, start, and database snapshot status deadline.
BACKUP_DATABASE_QUIESCE_TIMEOUT_SECONDS=120
# Maximum bytes accepted for each Neo4j or Weaviate snapshot archive during backup and restore.
BACKUP_MAX_DATABASE_ARCHIVE_BYTES=53687091200
# Completed local Neo4j/Weaviate native snapshot sets retained after authenticated publication (1-100); pruning runs only while the database services are quiesced.
BACKUP_LOCAL_SNAPSHOT_RETENTION_COUNT=3
# Validated offline rollback volumes retained per database after a successful restore cutover (1-20).
BACKUP_LOCAL_ROLLBACK_RETENTION_COUNT=1
# 0 (never long-running); the runner is invoked on demand via docker compose run.
# (auto-managed)
BACKUP_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# media: Blender MCP  (services/blender-mcp/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: localhost | managed-localhost | disabled
BLENDER_MCP_SOURCE=disabled

# Hostname written into the BLENDER_MCP_ENDPOINT hint for MCP clients. It does not change where the socket binds; BLENDER_MCP_BIND and BLENDER_MCP_ALLOW_REMOTE set the managed bind.
BLENDER_MCP_HOST=localhost
# Host port for the Blender MCP add-on socket. This is a host-tool port hint, not a Kong or container port.
BLENDER_MCP_LOCALHOST_PORT=9876
# Resolved endpoint hint for MCP clients when BLENDER_MCP_SOURCE is a host source (localhost / managed-localhost).
# (auto-managed)
BLENDER_MCP_ENDPOINT=
# State directory for the managed-localhost source: pinned add-on, generated headless launcher, pid and log files. `./start.sh blender-mcp remove` deletes it.
BLENDER_MCP_STATE_DIR=~/.atlas/blender-mcp
# Size of the managed-localhost pool, 1 to 16 (consumer manifest blender_mcp.instances). Instance 0 uses BLENDER_MCP_STATE_DIR and BLENDER_MCP_LOCALHOST_PORT; instance i uses <state dir>/instances/i and port BLENDER_MCP_LOCALHOST_PORT+i. Excess instances stop at the next start.
BLENDER_MCP_INSTANCES=1
# Bind address for the managed headless bridge. Loopback-only by default — execute_code runs arbitrary Python inside Blender; any other value is refused unless BLENDER_MCP_ALLOW_REMOTE=true.
BLENDER_MCP_BIND=127.0.0.1
# Explicit second opt-in required to bind the managed bridge beyond loopback. Leave false unless you own the network boundary.
BLENDER_MCP_ALLOW_REMOTE=false
# Explicit Blender binary for the managed source. Empty = auto-detect (/Applications/Blender.app on macOS, `blender` on PATH elsewhere). Atlas manages the MCP bridge, not the Blender application — install Blender yourself.
BLENDER_MCP_BLENDER_PATH=
# Pinned ahujasid/blender-mcp ref whose addon.py the managed source provisions. Move together with BLENDER_MCP_ADDON_SHA256.
BLENDER_MCP_ADDON_REF=6641189231caf3752302ae20591bc87fda85fc4e
# sha256 of the pinned addon.py; the manager refuses to install a mismatching download (it will later execute arbitrary Python).
BLENDER_MCP_ADDON_SHA256=bba60831f5f89a74deda0294b131668a086cf46eb35a6a01abbd0d21d9e92630
# Escape hatch: use a local add-on file instead of the pinned download (no sha verification; preflight warns).
BLENDER_MCP_ADDON_FILE=

# ──────────────────────────────────────────────────────────────────────────
# agents: Celery + Flower (async jobs)  (services/celery/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
CELERY_SOURCE=disabled

# Image references
FLOWER_IMAGE=mher/flower:2.0.1

# Set by ./start.sh from CELERY_SOURCE; do not edit. 1 runs celery-worker, 0 does not.
# (auto-managed)
CELERY_WORKER_SCALE=
# Set by ./start.sh from CELERY_SOURCE; do not edit. 1 runs the Flower monitoring UI, 0 does not.
# (auto-managed)
FLOWER_SCALE=
# Host port for Flower (in-container 5555).
FLOWER_PORT=63071
# Redis broker URL; Atlas uses Redis database 4 for Celery.
# (auto-managed)
CELERY_BROKER_URL=
# Redis result backend URL; Atlas uses Redis database 4 for Celery task state.
# (auto-managed)
CELERY_RESULT_BACKEND=
# Default Celery queue consumed by the Atlas backend worker.
CELERY_QUEUE=atlas
# Positive worker process concurrency for backend async jobs. Invalid values fail Backend and worker startup.
CELERY_WORKER_CONCURRENCY=2
# Positive prefetch multiplier. The default reduces head-of-line blocking for long tasks; invalid values fail startup.
CELERY_WORKER_PREFETCH_MULTIPLIER=1
# Positive hard per-task limit. Must exceed the soft limit and remain below the broker visibility timeout.
CELERY_TASK_TIME_LIMIT_SECONDS=900
# Positive soft per-task limit. Must be strictly less than the hard limit.
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=840
# Positive Redis broker visibility timeout, strictly greater than the task hard limit. The worker raises it to 300 s past max(rag_ingestion hard limit, global hard limit + 60) when larger, so running or delayed tasks are not re-delivered.
CELERY_BROKER_VISIBILITY_TIMEOUT_SECONDS=3600
# Positive soft limit for the rag_ingestion task alone; other tasks keep CELERY_TASK_SOFT_TIME_LIMIT_SECONDS. Empty means the larger of 3840 and that value. An ingestion whose graph targets' timeout_seconds sum to at least this is refused at submission.
RAG_INGESTION_TASK_SOFT_TIME_LIMIT_SECONDS=
# Positive hard limit for the rag_ingestion task alone; must exceed the soft limit. Empty (default) means the larger of 3900 and CELERY_TASK_TIME_LIMIT_SECONDS.
RAG_INGESTION_TASK_TIME_LIMIT_SECONDS=

# ──────────────────────────────────────────────────────────────────────────
# media: Chatterbox (voice-cloning TTS, GPU)  (services/chatterbox/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Image references
# Rolling :gpu tag, pinned by digest. To refresh, run `docker pull travisvn/chatterbox-tts-api:gpu` and replace the digest.
CHATTERBOX_IMAGE=travisvn/chatterbox-tts-api:gpu@sha256:8c0b379172d48b49d59d8f29a35fa23c0dc27955dba4d3ab41a77b2d71b4711f

# Host port for the Chatterbox container (in-container listen port is 4123).
CHATTERBOX_PORT=63059
# Host port for the chatterbox-localhost source variant. URL is derived at compose-render time as http://host.docker.internal:63044.
CHATTERBOX_LOCALHOST_PORT=63044
# Computed by bootstrapper/services/service_config.py::_generate_tts_provider_config — set to 1 when TTS_PROVIDER_SOURCE=chatterbox-container-gpu.
# (auto-managed)
CHATTERBOX_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# llm: Cloud LLM providers (OpenAI, Anthropic, OpenRouter)  (services/cloud-providers/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Options: enabled, disabled.
CLOUD_OPENAI_SOURCE=disabled
# OpenAI API key used by LiteLLM when CLOUD_OPENAI_SOURCE=enabled.
# (secret)
OPENAI_API_KEY=
# Comma-separated OpenAI model names the wizard activated.
OPENAI_USER_MODELS=
# Options: enabled, disabled.
CLOUD_ANTHROPIC_SOURCE=disabled
# Anthropic API key used by LiteLLM when CLOUD_ANTHROPIC_SOURCE=enabled.
# (secret)
ANTHROPIC_API_KEY=
# Comma-separated Anthropic model names the wizard activated.
ANTHROPIC_USER_MODELS=
# Options: enabled, disabled.
CLOUD_OPENROUTER_SOURCE=disabled
# OpenRouter API key used by LiteLLM when CLOUD_OPENROUTER_SOURCE=enabled.
# (secret)
OPENROUTER_API_KEY=
# Comma-separated OpenRouter model names the wizard activated.
OPENROUTER_USER_MODELS=
# Derived from CLOUD_OPENAI_SOURCE.
