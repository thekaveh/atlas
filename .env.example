# Set by ./start.sh from LANGFUSE_SOURCE; do not edit. 1 runs langfuse-clickhouse, 0 does not.
# (auto-managed)
LANGFUSE_CLICKHOUSE_SCALE=
# Set by ./start.sh from LANGFUSE_SOURCE; do not edit. 1 runs langfuse-init, 0 does not.
# (auto-managed)
LANGFUSE_INIT_SCALE=
# Postgres database for Langfuse. Supabase db-init (05-scoped-roles.sh) creates it.
LANGFUSE_DB_NAME=langfuse
# Bootstrapper-synchronized percent-encoded LANGFUSE_DB_NAME for DSN path components.
LANGFUSE_DB_NAME_URI=langfuse
# Scoped Postgres login that owns LANGFUSE_DB_NAME. Supabase db-init (05-scoped-roles.sh) creates it.
LANGFUSE_DB_USER=langfuse
# Auto-generated password for the owner of Langfuse's dedicated database.
# (secret)
LANGFUSE_DB_PASSWORD=atlas-db-password
# Bootstrapper-synchronized percent-encoded LANGFUSE_DB_USER for DSN userinfo.
LANGFUSE_DB_USER_URI=langfuse
# Bootstrapper-synchronized percent-encoded LANGFUSE_DB_PASSWORD for DSN userinfo.
# (secret)
LANGFUSE_DB_PASSWORD_URI=atlas-db-password
# Auto-generated by the bootstrapper on first run.
# (secret)
LANGFUSE_SALT=
# 64 hex chars. Auto-generated by the bootstrapper on first run.
# (secret)
LANGFUSE_ENCRYPTION_KEY=
# Auto-generated by the bootstrapper on first run.
# (secret)
LANGFUSE_NEXTAUTH_SECRET=
# Initial Langfuse project public key used by LiteLLM tracing.
# (secret)
LANGFUSE_PUBLIC_KEY=
# Initial Langfuse project secret key used by LiteLLM tracing.
# (secret)
LANGFUSE_SECRET_KEY=
