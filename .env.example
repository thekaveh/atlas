LOKI_RETENTION_PERIOD=24h

# ──────────────────────────────────────────────────────────────────────────
# agents: Curated MCP Servers  (services/mcp-servers/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
MCP_SERVERS_SOURCE=disabled

# Image references
# Used as build-arg BASE_IMAGE in build/Dockerfile.
MCP_SERVERS_IMAGE=python:3.12.13-slim

# Host port for the curated MCP Streamable HTTP endpoint (container port 8000).
MCP_SERVERS_PORT=63078
# Replicas: 1 when MCP_SERVERS_SOURCE=container, else 0.
# (auto-managed)
MCP_SERVERS_SCALE=
# Maximum rows returned by the Postgres MCP query tool.
MCP_POSTGRES_MAX_ROWS=50
