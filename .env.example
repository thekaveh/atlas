TEMPO_RETENTION_PERIOD=336h

# ──────────────────────────────────────────────────────────────────────────
# media: Apache Tika (fallback extractor)  (services/tika/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | tika-localhost | disabled
TIKA_SOURCE=disabled

# Image references
TIKA_IMAGE=apache/tika:3.3.1.0

# Host port for the Tika server (in-container 9998), bound to HOST_BIND_IP (loopback by default).
TIKA_PORT=63057
# Host port for the tika-localhost source variant.
TIKA_LOCALHOST_PORT=9998
# JVM memory cap for the Tika server container.
TIKA_JAVA_TOOL_OPTIONS=-Xmx768m
# Positive Backend maximum bytes accepted for Docling/Tika extraction; invalid values fail Backend startup.
TIKA_MAX_FILE_SIZE=52428800
# Finite Backend timeout in seconds for Tika fallback extraction calls. Must be greater than 0 and no greater than 3600; invalid values fail Backend startup.
TIKA_TIMEOUT_SECONDS=30
# Set by ./start.sh from TIKA_SOURCE; do not edit. 1 runs tika for container, 0 otherwise.
# (auto-managed)
TIKA_SCALE=
# Resolved per TIKA_SOURCE: http://tika:9998, the tika-localhost URL, or empty when disabled. Read by backend, celery and n8n.
# (auto-managed)
TIKA_ENDPOINT=

# ──────────────────────────────────────────────────────────────────────────
# data: Trino  (services/trino/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
TRINO_SOURCE=disabled

# Image references
# Pinned to the current Trino release tag validated against the Iceberg REST + MinIO catalog contract.
TRINO_IMAGE=trinodb/trino:482

# Host port for the Trino coordinator UI/API (in-container 8080).
TRINO_PORT=63029
# Set by ./start.sh from TRINO_SOURCE; do not edit. 1 runs trino, 0 does not.
# (auto-managed)
TRINO_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# agents: TrueForge (agent runtime: MCP + approvals + schedules)  (services/trueforge/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
TRUEFORGE_SOURCE=disabled

# Image references
TRUEFORGE_IMAGE=tfy.jfrog.io/tfy-images/trueforge:0.2.0-8b1d98e

# Host port for the TrueForge server UI + API (in-container 8790).
TRUEFORGE_PORT=63079
# Resolved per TRUEFORGE_SOURCE — `http://trueforge:8790` for container, empty for disabled.
# (auto-managed)
TRUEFORGE_ENDPOINT=
# Auto-generated by the bootstrapper on first run. Service credential for the controller's internal schedule-dispatch calls to the server.
# (secret)
TRUEFORGE_API_KEY=
# Name of TrueForge's dedicated database, created by supabase-db-init.
TRUEFORGE_DB_NAME=trueforge
# Bootstrapper-synchronized percent-encoded TRUEFORGE_DB_NAME for DSN path components.
TRUEFORGE_DB_NAME_URI=trueforge
# Login name of the owner of TrueForge's dedicated database, created by supabase-db-init.
TRUEFORGE_DB_USER=trueforge
# Auto-generated password for the owner of TrueForge's dedicated database.
# (secret)
TRUEFORGE_DB_PASSWORD=atlas-db-password
# Bootstrapper-synchronized percent-encoded TRUEFORGE_DB_USER for DSN userinfo.
TRUEFORGE_DB_USER_URI=trueforge
# Bootstrapper-synchronized percent-encoded TRUEFORGE_DB_PASSWORD for DSN userinfo.
# (secret)
TRUEFORGE_DB_PASSWORD_URI=atlas-db-password
# Set by ./start.sh from TRUEFORGE_SOURCE; do not edit. 1 runs the trueforge server, 0 does not.
# (auto-managed)
TRUEFORGE_SCALE=
# Set by ./start.sh from TRUEFORGE_SOURCE; do not edit. 1 runs trueforge-controller, 0 does not.
# (auto-managed)
TRUEFORGE_CONTROLLER_SCALE=
# Set by ./start.sh from TRUEFORGE_SOURCE; do not edit. 1 runs trueforge-init, 0 does not.
# (auto-managed)
TRUEFORGE_INIT_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# media: TTS provider (text-to-speech engine selector)  (services/tts-provider/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: speaches-container-cpu | speaches-container-gpu | chatterbox-container-gpu | chatterbox-localhost | disabled
TTS_PROVIDER_SOURCE=speaches-container-cpu

# Wizard display slot. Real engine port lives on its own container manifest.
TTS_PROVIDER_PORT=63058
# Set by ./start.sh; do not edit. 1 when a container engine serves text-to-speech, else 0. The wizard uses it to colour the TTS row.
# (auto-managed)
TTS_PROVIDER_SCALE=
# Resolved per TTS_PROVIDER_SOURCE. Read by n8n and jupyterhub; hermes-init receives it as TTS_INTERNAL_URL, and Open WebUI gets derived OPEN_WEB_UI_TTS_* values. The backend receives it but does not use it.
# (auto-managed)
TTS_ENDPOINT=

# ──────────────────────────────────────────────────────────────────────────
# apps: Verba (archived Weaviate RAG UI)  (services/verba/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
VERBA_SOURCE=disabled

# Image references
# Upstream publishes semitechnologies/verba:latest but no v2.1.3 Docker tag; Atlas pins the observed multi-arch index digest.
VERBA_IMAGE=semitechnologies/verba@sha256:0947d289ebff2c9814941c8d4282ee994dc79598e76162ae82e6efda4682b0b7

# Host port for the Verba UI/API (in-container 8000).
VERBA_PORT=63098
# In-network URL for Atlas services and notebooks.
# (auto-managed)
VERBA_ENDPOINT=
# Set by ./start.sh from VERBA_SOURCE; do not edit. 1 runs verba, 0 does not.
# (auto-managed)
VERBA_SCALE=
# Resolved Weaviate URL passed to upstream WEAVIATE_URL_VERBA, which Verba reads only for its Weaviate (cloud) deployment; the default Docker deployment always dials weaviate:8080. For WEAVIATE_SOURCE=localhost pick Custom on Verba's connect screen.
# (auto-managed)
VERBA_WEAVIATE_URL=
# Optional Verba OpenAI generator model name. Empty uses LITELLM_DEFAULT_MODEL (Verba itself would otherwise start with an empty model name).
VERBA_OPENAI_MODEL=
# Optional Verba OpenAI-compatible embedding model name. Empty uses LITELLM_EMBEDDING_MODEL.
VERBA_OPENAI_EMBED_MODEL=
# Verba deployment selector. Atlas uses Docker to target the external Weaviate container.
VERBA_DEFAULT_DEPLOYMENT=Docker

# ──────────────────────────────────────────────────────────────────────────
# llm: vLLM (Metal) — managed Apple-silicon LLM server  (services/vllm-metal/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: managed-localhost | disabled
VLLM_METAL_SOURCE=disabled

# Hugging Face model id served by the managed vLLM Metal process and registered with LiteLLM under the same alias.
VLLM_METAL_MODEL=Qwen/Qwen2.5-7B-Instruct
# Host port the managed vLLM Metal OpenAI server listens on. Not a BASE_PORT slot — vLLM Metal has no Kong route or exposed stack port.
VLLM_METAL_LOCALHOST_PORT=8000
# Atlas-verified vllm-metal GitHub release wheel installed with checksum verification; unverified overrides are rejected.
VLLM_METAL_PLUGIN_VERSION=0.3.0.dev20260713103604
# Atlas-verified compatible vllm core source release; it must match the supported plugin release.
VLLM_METAL_CORE_VERSION=0.24.0
# Python interpreter used to build the managed host venv (vllm-metal requires 3.12).
VLLM_METAL_PYTHON=python3.12
# Host directory holding the managed venv plus the pid / log / status files.
VLLM_METAL_STATE_DIR=~/.atlas/vllm-metal
# Optional Hugging Face cache dir (HF_HOME) for the managed process. Blank = default HF cache.
VLLM_METAL_MODELS_PATH=
# Unified-memory warning floor (GB) checked before lifecycle work; memory below it warns and unreadable memory skips the check. The result does not block install or start and does not certify model fit or prevent OOM.
VLLM_METAL_MIN_MEMORY_GB=16
# Always 0 — vLLM Metal never runs as a container. Reserved for interface parity with container services.
# (auto-managed)
VLLM_METAL_SCALE=
# Resolved docker-internal URL of the managed host process (http://host.docker.internal:${VLLM_METAL_LOCALHOST_PORT}). Consumed by litellm-init to register the model. Blank when disabled.
# (auto-managed)
VLLM_METAL_ENDPOINT=

# ──────────────────────────────────────────────────────────────────────────
# data: Weaviate (vector database)  (services/weaviate/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | localhost | disabled
WEAVIATE_SOURCE=container

# Image references
WEAVIATE_IMAGE=cr.weaviate.io/semitechnologies/weaviate:1.38.17
WEAVIATE_INIT_IMAGE=alpine:3.24.2
MULTI2VEC_CLIP_IMAGE=semitechnologies/multi2vec-clip:sentence-transformers-clip-ViT-B-32-1.5.1

# Host port for the Weaviate REST API (in-container 8080), bound to HOST_BIND_IP (loopback by default).
WEAVIATE_PORT=63030
# Host port for the Weaviate gRPC API (in-container 50051), bound to HOST_BIND_IP (loopback by default).
WEAVIATE_GRPC_PORT=63031
# Auto-managed by weaviate. Container/disabled.
WEAVIATE_INIT_SOURCE=container
# Options: container-cpu, container-gpu, disabled. container-gpu sets ENABLE_CUDA=1, but Compose reserves no GPU device yet. The CLIP container then fails to start; use container-cpu.
MULTI2VEC_CLIP_SOURCE=container-cpu
# Weaviate module list (ENABLE_MODULES). ./start.sh adds or removes multi2vec-clip to match MULTI2VEC_CLIP_SOURCE and keeps any other modules you list.
WEAVIATE_ENABLE_MODULES=text2vec-openai,text2vec-ollama,multi2vec-clip,generative-openai,generative-ollama,backup-filesystem
# URL Weaviate uses for the multi2vec-clip module. ./start.sh empties it when MULTI2VEC_CLIP_SOURCE=disabled.
CLIP_INFERENCE_API=http://multi2vec-clip:8080
# Opt-in SigLIP 2 image reference for MULTI2VEC_CLIP_IMAGE. Produces 1152-d vectors; revectorize or create new Weaviate collections before switching.
MULTI2VEC_CLIP_SIGLIP2_IMAGE=semitechnologies/multi2vec-clip:google-siglip2-so400m-patch16-512-1.5.1
# Resolved per WEAVIATE_SOURCE. Consumed by n8n, backend, jupyterhub.
# (auto-managed)
WEAVIATE_URL=
# Mirror of LITELLM_MASTER_KEY for Weaviate's vectorizer auth.
# (auto-managed, secret)
WEAVIATE_LITELLM_API_KEY=
# Set by ./start.sh from WEAVIATE_SOURCE; do not edit. 1 runs weaviate for container, 0 otherwise.
# (auto-managed)
WEAVIATE_SCALE=
# Set by ./start.sh from WEAVIATE_SOURCE; do not edit. 1 runs weaviate-init with a container Weaviate, 0 otherwise.
# (auto-managed)
WEAVIATE_INIT_SCALE=
# Computed from MULTI2VEC_CLIP_SOURCE.
# (auto-managed)
CLIP_SCALE=
# Set by ./start.sh from MULTI2VEC_CLIP_SOURCE; do not edit. Passed to multi2vec-clip as ENABLE_CUDA. container-gpu sets 1, but compose requests no GPU device.
# (auto-managed)
CLIP_ENABLE_CUDA=
# Set by ./start.sh from the multi2vec-clip deploy slice; `~` means none. No compose file reads it.
CLIP_DEPLOY_RESOURCES=~
# Host port for the weaviate-localhost source variant. URL is derived at compose-render time as http://host.docker.internal:8080.
WEAVIATE_LOCALHOST_PORT=8080
# Container memory limit for the weaviate container (deploy.resources.limits.memory). The 2g default is conservative for a 32 GB host. It fits the Go data plane and in-memory HNSW index for small-to-medium collections.
WEAVIATE_MEMORY_LIMIT=2g
# Container CPU limit for the weaviate container (deploy.resources.limits.cpus). 1.5 cores covers routine indexing and query serving on a shared host.
WEAVIATE_CPU_LIMIT=1.5

# ──────────────────────────────────────────────────────────────────────────
# apps: Apache Zeppelin (Spark-first notebook)  (services/zeppelin/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
ZEPPELIN_SOURCE=disabled

# Image references
ZEPPELIN_IMAGE=apache/zeppelin:0.12.1
ZEPPELIN_INIT_IMAGE=python:3.12.13-alpine

# Cores the long-lived Zeppelin Spark interpreter may hold (spark.cores.max, re-seeded each start). Uncapped, it takes every free worker core and leaves Airflow SparkSubmit drivers waiting. Raise it only with spare cores beyond Spark Connect and Airflow.
ZEPPELIN_SPARK_CORES_MAX=1
# Read-only PostgreSQL login exposed to Zeppelin's JDBC interpreter.
ZEPPELIN_DB_USER=atlas_zeppelin
# Auto-generated password for Zeppelin's read-only database role.
# (secret)
ZEPPELIN_DB_PASSWORD=atlas-db-password
# Host port for the Zeppelin Web UI (in-container 8080).
ZEPPELIN_PORT=63099
# Set by ./start.sh from ZEPPELIN_SOURCE; do not edit. 1 runs zeppelin, 0 does not.
# (auto-managed)
ZEPPELIN_SCALE=
# Set by ./start.sh from ZEPPELIN_SOURCE; do not edit. 1 runs zeppelin-init, 0 does not.
# (auto-managed)
ZEPPELIN_INIT_SCALE=
# Container memory limit for the zeppelin container (deploy.resources.limits.memory). Zeppelin's JVM-based interpreter host typically uses under 1 g for a single-user session; 2 g leaves comfortable headroom on a 32 GB host.
ZEPPELIN_MEMORY_LIMIT=2g
# Container CPU limit for the zeppelin container (deploy.resources.limits.cpus). 1.5 cores covers notebook rendering and interpreter dispatch. Compute-heavy work runs on the remote Spark cluster, not in this process.
ZEPPELIN_CPU_LIMIT=1.5
