# ──────────────────────────────────────────────────────────────────────────
# data: Apache Spark (standalone cluster)  (services/spark/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
SPARK_SOURCE=disabled

# Image references
SPARK_IMAGE=apache/spark:4.1.2

# Host port for the Spark Master Web UI (in-container 8080).
SPARK_MASTER_UI_PORT=63027
# Host port for the Spark History Server (in-container 18080).
SPARK_HISTORY_PORT=63028
# Number of spark-worker replicas alongside the master. 1-8.
SPARK_WORKER_COUNT=2
# Set by ./start.sh from SPARK_SOURCE; do not edit. 1 runs spark-master, 0 does not.
# (auto-managed)
SPARK_MASTER_SCALE=
# Resolved by the bootstrapper from SPARK_WORKER_COUNT when source=container; 0 otherwise.
# (auto-managed)
SPARK_WORKER_SCALE=
# Set by ./start.sh from SPARK_SOURCE; do not edit. 1 runs the Spark History Server, 0 does not.
# (auto-managed)
SPARK_HISTORY_SCALE=
# Set by ./start.sh from SPARK_SOURCE; do not edit. 1 runs spark-init, which creates the spark-history bucket; 0 does not.
# (auto-managed)
SPARK_INIT_SCALE=
# Resolved by the bootstrapper from SPARK_SOURCE; spark-connect runs as a sidecar to spark-master.
# (auto-managed)
SPARK_CONNECT_SCALE=
# Maximum standalone-cluster cores the long-lived Spark Connect server may hold. Keep below total worker cores so Airflow SparkSubmit and Zeppelin standalone workloads can run alongside Connect; raise only when the worker pool has enough headroom.
SPARK_CONNECT_CORES_MAX=1
# Container memory limit for spark-master (deploy.resources.limits.memory). The standalone master process manages cluster state and requires minimal heap — 2 g is generous on a 32 GB host.
SPARK_MASTER_MEMORY_LIMIT=2g
# Container CPU limit for spark-master (deploy.resources.limits.cpus). Master is lightweight; 1.0 core is ample.
SPARK_MASTER_CPU_LIMIT=1.0
# Container memory limit per spark-worker (deploy.resources.limits.memory). Workers run executor JVMs; 4 g per replica is a conservative cap on a 32 GB host with the default 2 workers (8 g total). Raise for memory-intensive jobs.
SPARK_WORKER_MEMORY_LIMIT=4g
# Container CPU limit per spark-worker (deploy.resources.limits.cpus). 2.0 cores per worker leaves headroom for other services on the host.
SPARK_WORKER_CPU_LIMIT=2.0

# ──────────────────────────────────────────────────────────────────────────
# media: Speaches (unified TTS + STT)  (services/speaches/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Image references
# CPU build (default). When the speaches-gpu profile wins, the bootstrapper rewrites this var from SPEACHES_GPU_IMAGE at generation time.
SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:0.9.0-rc.3-cpu

# CUDA build of the same image. When the speaches-gpu profile wins, the bootstrapper writes this value into SPEACHES_IMAGE (the compose interpolation target).
SPEACHES_GPU_IMAGE=ghcr.io/speaches-ai/speaches:0.9.0-rc.3-cuda
# Model id Open WebUI sends in /v1/audio/speech requests. It must be the Speaches Kokoro ONNX executor id (speaches-ai/Kokoro-82M-v1.0-ONNX). The HuggingFace 'hexgrad/Kokoro-82M' id is invalid for Speaches and returns 404.
SPEACHES_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# Inert: Speaches preloads from a hard-coded `PRELOAD_MODELS` list, and Open WebUI requests `whisper-1`. Changing this value has no effect.
SPEACHES_STT_MODEL=Systran/faster-distil-whisper-large-v3
# Host port for the Speaches container (in-container listen port is 8000).
SPEACHES_PORT=63060
# Computed by bootstrapper/services/service_config.py::_generate_stt_provider_config (or _generate_tts_provider_config) — set to 1 when STT_PROVIDER_SOURCE OR TTS_PROVIDER_SOURCE picks a speaches-* variant.
# (auto-managed)
SPEACHES_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# data: Supabase (db, auth, api, storage, realtime, studio, meta)  (services/supabase/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Image references
SUPABASE_DB_IMAGE=supabase/postgres:17.6.1.139
SUPABASE_DB_INIT_IMAGE=postgres:15.19-alpine
SUPABASE_META_IMAGE=supabase/postgres-meta:v0.96.6
SUPABASE_STORAGE_IMAGE=supabase/storage-api:v1.61.5
SUPABASE_AUTH_IMAGE=supabase/gotrue:v2.191.0
SUPABASE_API_IMAGE=postgrest/postgrest:v12.2.10
SUPABASE_REALTIME_IMAGE=supabase/realtime:v2.112.0
SUPABASE_STUDIO_IMAGE=supabase/studio:2026.06.22-sha-2207d7f
# Prometheus exporter sidecar. Scales 1↔0 with PROMETHEUS_SOURCE (gated by _generate_prometheus_config).
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.19.1

# Single-option (container only). Kept for forward-compat with legacy source-validator.
SUPABASE_DB_SOURCE=container
# Host port for supabase-db PostgreSQL (in-container 5432), bound to HOST_BIND_IP (loopback by default).
SUPABASE_DB_PORT=63012
# Postgres superuser name, passed to supabase-db as POSTGRES_USER and used by supabase-db-init.
SUPABASE_DB_USER=supabase_admin
# Supabase postgres admin password; auto-generated by the bootstrapper when left as the placeholder.
# (secret)
SUPABASE_DB_PASSWORD=password
# Database name, passed to supabase-db as POSTGRES_DB and used by supabase-db-init, pg-meta and Realtime.
SUPABASE_DB_NAME=postgres
# Bootstrapper-synchronized percent-encoded SUPABASE_DB_NAME for DSN path components.
SUPABASE_DB_NAME_URI=postgres
# Reserved for a future least-privilege application-tier database user; not created by init scripts today.
SUPABASE_DB_APP_USER=app_user
# Reserved future app-user password; auto-generated by the bootstrapper when left as the placeholder.
# (secret)
SUPABASE_DB_APP_PASSWORD=app_password
# Login name of the Supabase Auth (GoTrue) schema owner. supabase-db-init creates it if missing and sets its password.
SUPABASE_AUTH_DB_USER=supabase_auth_admin
# Auto-generated login password for the upstream auth schema owner.
# (secret)
SUPABASE_AUTH_DB_PASSWORD=atlas-db-password
# Bootstrapper-synchronized percent-encoded SUPABASE_AUTH_DB_USER for DSN userinfo.
SUPABASE_AUTH_DB_USER_URI=supabase_auth_admin
# Bootstrapper-synchronized percent-encoded SUPABASE_AUTH_DB_PASSWORD for DSN userinfo.
# (secret)
SUPABASE_AUTH_DB_PASSWORD_URI=atlas-db-password
# Login name of the Supabase Storage schema owner. supabase-db-init creates it if missing and sets its password.
SUPABASE_STORAGE_DB_USER=supabase_storage_admin
# Auto-generated login password for the upstream storage schema owner.
# (secret)
SUPABASE_STORAGE_DB_PASSWORD=atlas-db-password
# Bootstrapper-synchronized percent-encoded SUPABASE_STORAGE_DB_USER for DSN userinfo.
SUPABASE_STORAGE_DB_USER_URI=supabase_storage_admin
# Bootstrapper-synchronized percent-encoded SUPABASE_STORAGE_DB_PASSWORD for DSN userinfo.
# (secret)
SUPABASE_STORAGE_DB_PASSWORD_URI=atlas-db-password
# Login name of the PostgREST's role-switching authenticator. supabase-db-init creates it if missing and sets its password.
SUPABASE_API_DB_USER=authenticator
# Auto-generated login password for PostgREST's role-switching authenticator.
# (secret)
SUPABASE_API_DB_PASSWORD=atlas-db-password
# Bootstrapper-synchronized percent-encoded SUPABASE_API_DB_USER for DSN userinfo.
SUPABASE_API_DB_USER_URI=authenticator
# Bootstrapper-synchronized percent-encoded SUPABASE_API_DB_PASSWORD for DSN userinfo.
# (secret)
SUPABASE_API_DB_PASSWORD_URI=atlas-db-password
# Login name of the replication-scoped Realtime role. supabase-db-init creates it if missing and sets its password.
SUPABASE_REALTIME_DB_USER=atlas_realtime
# Auto-generated password for the replication-scoped Realtime role.
# (secret)
SUPABASE_REALTIME_DB_PASSWORD=atlas-db-password
# Login name of the dashboard metadata role used by pg-meta and Studio. supabase-db-init creates it if missing and sets its password.
SUPABASE_META_DB_USER=atlas_meta
# Auto-generated password for the dashboard metadata role used by Meta and Studio.
# (secret)
SUPABASE_META_DB_PASSWORD=atlas-db-password
# Auto-generated key shared by Studio (as PG_META_CRYPTO_KEY) and Postgres Meta (as CRYPTO_KEY) to encrypt the connection header Studio sends Meta. Empty falls back to the images' public SAMPLE_KEY constant.
# (secret)
SUPABASE_META_CRYPTO_KEY=
# Bootstrapper-synchronized percent-encoded SUPABASE_META_DB_USER for DSN userinfo.
SUPABASE_META_DB_USER_URI=atlas_meta
# Bootstrapper-synchronized percent-encoded SUPABASE_META_DB_PASSWORD for DSN userinfo.
# (secret)
SUPABASE_META_DB_PASSWORD_URI=atlas-db-password
# Read-only SQL-editor identity used by Studio; it shares Studio's single password interface with Meta but has no Meta admin authority.
SUPABASE_STUDIO_DB_USER=atlas_studio_readonly
# Bootstrapper-synchronized percent-encoded SUPABASE_STUDIO_DB_USER for Studio's constructed DSN.
SUPABASE_STUDIO_DB_USER_URI=atlas_studio_readonly
# Container only: the post-init SQL runner every Supabase-backed service waits for. Other values are rejected.
SUPABASE_DB_INIT_SOURCE=container
# Host port for postgres-exporter (in-container 9187). Sidecar gated by PROMETHEUS_SOURCE.
POSTGRES_EXPORTER_PORT=63013
# Set by _generate_prometheus_config() to 1 when PROMETHEUS_SOURCE=container, 0 otherwise.
# (auto-managed)
POSTGRES_EXPORTER_SCALE=
# Login name of the pg_monitor-only role postgres-exporter uses. supabase-db-init creates it if missing and sets its password.
POSTGRES_EXPORTER_DB_USER=atlas_metrics
# Auto-generated password for the pg_monitor-only exporter role.
# (secret)
POSTGRES_EXPORTER_DB_PASSWORD=atlas-db-password
# Bootstrapper-synchronized percent-encoded POSTGRES_EXPORTER_DB_USER for DSN userinfo.
POSTGRES_EXPORTER_DB_USER_URI=atlas_metrics
# Bootstrapper-synchronized percent-encoded POSTGRES_EXPORTER_DB_PASSWORD for DSN userinfo.
# (secret)
POSTGRES_EXPORTER_DB_PASSWORD_URI=atlas-db-password
# Deployment source for pg-meta (supabase-meta): container (default) or disabled.
SUPABASE_META_SOURCE=container
# Set by ./start.sh from SUPABASE_META_SOURCE; do not edit. 1 runs the container, 0 (disabled) does not.
# (auto-managed)
SUPABASE_META_SCALE=
# Reserved port slot for pg-meta; not published on the host. Reach it through Kong at /pg/.
SUPABASE_META_PORT=63014
# Deployment source for Supabase Storage (supabase-storage): container (default) or disabled.
SUPABASE_STORAGE_SOURCE=container
# Set by ./start.sh from SUPABASE_STORAGE_SOURCE; do not edit. 1 runs the container, 0 (disabled) does not.
# (auto-managed)
SUPABASE_STORAGE_SCALE=
# Host port for Supabase Storage (in-container 5000), bound to HOST_BIND_IP (loopback by default).
SUPABASE_STORAGE_PORT=63015
# Region name passed to Supabase Storage as REGION.
STORAGE_REGION=local
# Maximum upload size in bytes for Supabase Storage (FILE_SIZE_LIMIT). The default is 50 MiB.
STORAGE_FILE_SIZE_LIMIT=52428800
# Supabase Storage backend. The default `file` stores objects in the storage volume at /var/lib/storage.
STORAGE_BACKEND=file
# Project reference passed to Supabase Storage as PROJECT_REF.
PROJECT_REF=default
# Tenant id passed to Supabase Storage as TENANT_ID.
TENANT_ID=stub
# Deployment source for Supabase Auth, GoTrue (supabase-auth): container (default) or disabled.
SUPABASE_AUTH_SOURCE=container
# Set by ./start.sh from SUPABASE_AUTH_SOURCE; do not edit. 1 runs the container, 0 (disabled) does not.
# (auto-managed)
SUPABASE_AUTH_SCALE=
# Reserved port slot for Supabase Auth (GoTrue); not published on the host. Reach it through Kong at /auth/v1.
SUPABASE_AUTH_PORT=63016
# Auto-generated by bootstrapper/generate_supabase_keys.py on first run.
# (secret)
SUPABASE_JWT_SECRET=
# Auto-generated.
# (secret)
SUPABASE_ANON_KEY=
# Auto-generated.
# (secret)
SUPABASE_SERVICE_KEY=
# Deployment source for PostgREST (supabase-api): container (default) or disabled.
SUPABASE_API_SOURCE=container
# Set by ./start.sh from SUPABASE_API_SOURCE; do not edit. 1 runs the container, 0 (disabled) does not.
# (auto-managed)
SUPABASE_API_SCALE=
# Host port for PostgREST (in-container 3000), bound to HOST_BIND_IP (loopback by default).
SUPABASE_API_PORT=63017
# Deployment source for Supabase Realtime (supabase-realtime): container (default) or disabled.
SUPABASE_REALTIME_SOURCE=container
# Set by ./start.sh from SUPABASE_REALTIME_SOURCE; do not edit. 1 runs the container, 0 (disabled) does not.
# (auto-managed)
SUPABASE_REALTIME_SCALE=
# Host port for Supabase Realtime (in-container 4000), bound to HOST_BIND_IP (loopback by default).
SUPABASE_REALTIME_PORT=63018
# Deployment source for Supabase Studio (supabase-studio): container (default) or disabled.
SUPABASE_STUDIO_SOURCE=container
# Set by ./start.sh from SUPABASE_STUDIO_SOURCE; do not edit. 1 runs the container, 0 (disabled) does not.
# (auto-managed)
SUPABASE_STUDIO_SCALE=
# Reserved port slot for Supabase Studio; not published on the host. Reach it through Kong.
SUPABASE_STUDIO_PORT=63019

# ──────────────────────────────────────────────────────────────────────────
# data: Supavisor (Postgres transaction pooler)  (services/supavisor/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
SUPAVISOR_SOURCE=disabled

# Image references
SUPAVISOR_IMAGE=supabase/supavisor:2.9.5

# Scoped owner for Supavisor's dedicated management database.
SUPAVISOR_DB_ADMIN_USER=atlas_supavisor
# Auto-generated password for Supavisor management migrations and auth lookup.
# (secret)
SUPAVISOR_DB_ADMIN_PASSWORD=atlas-db-password
# Bootstrapper-synchronized percent-encoded SUPAVISOR_DB_ADMIN_USER for DSN userinfo.
SUPAVISOR_DB_ADMIN_USER_URI=atlas_supavisor
# Bootstrapper-synchronized percent-encoded SUPAVISOR_DB_ADMIN_PASSWORD for DSN userinfo.
# (secret)
SUPAVISOR_DB_ADMIN_PASSWORD_URI=atlas-db-password
# 1 when SUPAVISOR_SOURCE=container, otherwise 0.
# (auto-managed)
SUPAVISOR_SCALE=
# Supavisor tenant suffix. Clients connect as <db_user>.<tenant>; only ASCII letters, digits, underscores, and hyphens are accepted because dot is the upstream user/tenant delimiter.
SUPAVISOR_TENANT_ID=atlas
# Default upstream Postgres pool size for the Atlas tenant.
SUPAVISOR_DEFAULT_POOL_SIZE=20
# Maximum client connections accepted by the Atlas tenant.
SUPAVISOR_MAX_CLIENT_CONN=100
# Supavisor metadata database pool size.
SUPAVISOR_DB_POOL_SIZE=5
# Generated Postgres URL consumed by backend/Celery; points at Supavisor when enabled and direct Supabase Postgres when disabled.
# (auto-managed)
SUPAVISOR_DATABASE_URL=
# Generated n8n Postgres host; supavisor when enabled, supabase-db when disabled.
# (auto-managed)
SUPAVISOR_DB_HOST=
# Generated n8n Postgres port; 6543 when enabled, 5432 when disabled.
# (auto-managed)
SUPAVISOR_DB_PORT_VALUE=
# Generated n8n Postgres user; appends .${SUPAVISOR_TENANT_ID} when Supavisor is enabled.
# (auto-managed)
SUPAVISOR_DB_USER=
# Supavisor Phoenix secret; auto-generated by the bootstrapper when blank.
# (secret)
SUPAVISOR_SECRET_KEY_BASE=
# Supavisor vault encryption key; must be exactly 32 bytes and is auto-generated when blank.
# (secret)
SUPAVISOR_VAULT_ENC_KEY=
# Supavisor tenant API JWT secret; auto-generated by the bootstrapper when blank.
# (secret)
SUPAVISOR_API_JWT_SECRET=
# Supavisor metrics JWT secret; auto-generated by the bootstrapper when blank.
# (secret)
SUPAVISOR_METRICS_JWT_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# llm: TEI Reranker (mxbai-rerank-base-v1)  (services/tei-reranker/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container-cpu | container-gpu | localhost | disabled
TEI_RERANKER_SOURCE=disabled

# Image references
# Used when TEI_RERANKER_SOURCE=container-cpu on amd64 hosts. Compiled with ORT backend (requires ONNX model weights). Digest-pinned: the cpu-1.9 family tag is republished per patch.
TEI_RERANKER_CPU_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9@sha256:ad950d30878eceb72aaf32024d26fa2b1d04a75304fa0b4776b49aa1941fea07
# Used when TEI_RERANKER_SOURCE=container-cpu on arm64 hosts (Apple Silicon). Compiled with candle backend (loads safetensors natively, no ONNX required). Unversioned tag — HF doesn't publish versioned arm64 tags as of 2026-06-06.
TEI_RERANKER_CPU_ARM64_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-latest@sha256:35c50d7494de22deecdb783b8f5b7e1d05765709bd90071b03469b9440d28656
# Used when TEI_RERANKER_SOURCE=container-gpu. CUDA host required. Digest-pinned: the 1.9 minor tag is republished per patch.
TEI_RERANKER_GPU_IMAGE=ghcr.io/huggingface/text-embeddings-inference:1.9@sha256:536efce2a0dc0acd0336d683ef1b81fcf900f76c8fb850e25a6d48a54a97df91

# Host port for the TEI rerank API (in-container listen port is 80).
TEI_RERANKER_PORT=63041
# Host port for the host-installed TEI rerank source variant.
TEI_RERANKER_LOCALHOST_PORT=63049
# Hugging Face model id TEI serves (--model-id).
TEI_RERANKER_MODEL_ID=mixedbread-ai/mxbai-rerank-base-v1
# Model revision TEI loads (--revision). The default pins a commit of the default model.
TEI_RERANKER_REVISION=800f24c113213a187e65bde9db00c15a2bb12738
# Maximum inputs per client request TEI accepts (--max-client-batch-size).
TEI_RERANKER_MAX_CLIENT_BATCH_SIZE=32
# Container memory limit for tei-reranker (deploy.resources.limits.memory).
TEI_RERANKER_MEMORY_LIMIT=4g
# Container CPU limit for tei-reranker (deploy.resources.limits.cpus).
TEI_RERANKER_CPU_LIMIT=2.0
# In-container Hugging Face cache (HF_HOME). The default /data is the tei-reranker-data volume, so models persist across restarts.
TEI_RERANKER_HF_CACHE_DIR=/data
# Set by ./start.sh from TEI_RERANKER_SOURCE; do not edit. 1 runs tei-reranker for container-cpu and container-gpu, 0 otherwise.
# (auto-managed)
TEI_RERANKER_SCALE=
# Resolved per TEI_RERANKER_SOURCE. Exposes TEI's rerank endpoint to compatible consumers.
# (auto-managed)
TEI_RERANKER_ENDPOINT=
# Image picked per source variant (CPU vs GPU).
# (auto-managed)
TEI_RERANKER_IMAGE_RESOLVED=

# ──────────────────────────────────────────────────────────────────────────
# infra: Tempo (distributed trace store)  (services/tempo/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
TEMPO_SOURCE=disabled

# Image references
TEMPO_IMAGE=grafana/tempo:3.0.0

# Set by ./start.sh from TEMPO_SOURCE; do not edit. 1 runs tempo, 0 does not.
# (auto-managed)
TEMPO_SCALE=
# Internal Tempo query/API endpoint consumed by Grafana.
# (auto-managed)
TEMPO_ENDPOINT=
