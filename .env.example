# Host port for the Langfuse web UI/API (in-container 3000).
LANGFUSE_PORT=63005
# In-network URL used by LiteLLM when Langfuse tracing is enabled.
# (auto-managed)
LANGFUSE_ENDPOINT=
# Set by ./start.sh from LANGFUSE_SOURCE; do not edit. 1 runs langfuse-web, 0 does not.
