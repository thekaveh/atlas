LANGFUSE_INIT_PROJECT_ID=atlas-default
# Project name that langfuse-web headless init creates on first start.
LANGFUSE_INIT_PROJECT_NAME=Atlas Default
# Login email of the initial Langfuse user that headless init creates on first start.
LANGFUSE_INIT_USER_EMAIL=admin@atlas.localhost
# Display name of the initial Langfuse user that headless init creates on first start.
LANGFUSE_INIT_USER_NAME=Atlas Admin
# Auto-generated by the bootstrapper on first run.
# (secret)
LANGFUSE_INIT_USER_PASSWORD=
# ClickHouse user for langfuse-clickhouse, also used by langfuse-web and langfuse-worker.
LANGFUSE_CLICKHOUSE_USER=clickhouse
# Auto-generated by the bootstrapper on first run.
# (secret)
LANGFUSE_CLICKHOUSE_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────
# agents: LightRAG (graph-augmented RAG server)  (services/lightrag/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | localhost | disabled
LIGHTRAG_SOURCE=disabled

# Image references
LIGHTRAG_IMAGE=ghcr.io/hkuds/lightrag:v1.5.4
LIGHTRAG_INIT_IMAGE=alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

# Scoped PostgreSQL owner for LightRAG PGVectorStorage relations.
LIGHTRAG_DB_USER=atlas_lightrag
# Auto-generated password for the scoped LightRAG database role.
# (secret)
LIGHTRAG_DB_PASSWORD=atlas-db-password
# Bootstrapper-synchronized percent-encoded LIGHTRAG_DB_USER for DSN userinfo.
LIGHTRAG_DB_USER_URI=atlas_lightrag
# Bootstrapper-synchronized percent-encoded LIGHTRAG_DB_PASSWORD for DSN userinfo.
# (secret)
LIGHTRAG_DB_PASSWORD_URI=atlas-db-password
# Host port for LightRAG (in-container 9621).
LIGHTRAG_API_PORT=63074
# Host port for the localhost source variant.
LIGHTRAG_LOCALHOST_PORT=63068
# Auto-generated bearer key. Forwarded to LiteLLM as the model api_key.
# (secret)
LIGHTRAG_API_KEY=
# Auto-generated JWT signing key for LightRAG's /login endpoint. Without this, LightRAG falls back to a hardcoded default key (security risk).
# (secret)
LIGHTRAG_TOKEN_SECRET=
# Passed as WORKERS but inert: the image starts lightrag.api.lightrag_server under a single uvicorn process (WORKERS is read only by lightrag-gunicorn).
LIGHTRAG_WORKERS=2
# Memory limit of the lightrag container.
LIGHTRAG_MEMORY_LIMIT=6g
# CPU limit (cores) of the lightrag container.
LIGHTRAG_CPU_LIMIT=2.0
# Base LightRAG LLM binding, through LiteLLM at LIGHTRAG_LLM_BINDING_HOST by default. A role without its own binding, host or key inherits it. Exception: with a direct-provider base, a role whose model declares catalog request_defaults stays on LiteLLM.
LIGHTRAG_LLM_BINDING=openai
# Base LightRAG LLM endpoint (LLM_BINDING_HOST). Default: the in-network LiteLLM.
LIGHTRAG_LLM_BINDING_HOST=http://litellm:4000/v1
# Empty = lightrag-init resolves from LITELLM_DEFAULT_MODEL.
LIGHTRAG_LLM_MODEL=
# Optional LightRAG EXTRACT role model. Empty = inherit LLM_MODEL.
LIGHTRAG_EXTRACT_LLM_MODEL=
# Optional LightRAG KEYWORD role model. Empty = inherit LLM_MODEL.
LIGHTRAG_KEYWORD_LLM_MODEL=
# Optional LightRAG QUERY role model. Empty = inherit LLM_MODEL.
LIGHTRAG_QUERY_LLM_MODEL=
# Optional EXTRACT role provider binding. Empty = inherit LLM_BINDING.
LIGHTRAG_EXTRACT_LLM_BINDING=
# Optional KEYWORD role provider binding. Empty = inherit LLM_BINDING.
LIGHTRAG_KEYWORD_LLM_BINDING=
# Optional QUERY role provider binding. Empty = inherit LLM_BINDING.
LIGHTRAG_QUERY_LLM_BINDING=
# Optional EXTRACT role provider endpoint. Empty = inherit LLM_BINDING_HOST.
LIGHTRAG_EXTRACT_LLM_BINDING_HOST=
# Optional KEYWORD role provider endpoint. Empty = inherit LLM_BINDING_HOST.
LIGHTRAG_KEYWORD_LLM_BINDING_HOST=
# Optional QUERY role provider endpoint. Empty = inherit LLM_BINDING_HOST.
LIGHTRAG_QUERY_LLM_BINDING_HOST=
# Optional EXTRACT role API key. Unset means the LiteLLM master key, but only if the role's effective host is the in-network LiteLLM. A role with its own binding or host elsewhere must set it, or the container exits.
# (secret)
LIGHTRAG_EXTRACT_LLM_BINDING_API_KEY=
# Optional KEYWORD role API key. Unset means the LiteLLM master key, but only if the role's effective host is the in-network LiteLLM. A role with its own binding or host elsewhere must set it, or the container exits.
# (secret)
LIGHTRAG_KEYWORD_LLM_BINDING_API_KEY=
# Optional QUERY role API key. Unset means the LiteLLM master key, but only if the role's effective host is the in-network LiteLLM. A role with its own binding or host elsewhere must set it, or the container exits.
# (secret)
LIGHTRAG_QUERY_LLM_BINDING_API_KEY=
# EXTRACT output cap in tokens when EXTRACT is bound to native Ollama; other bindings ignore it. Without it Ollama output is unbounded. Must be an integer. Cached extractions keep any truncation, so clear the LightRAG LLM cache after raising it.
LIGHTRAG_EXTRACT_OLLAMA_LLM_NUM_PREDICT=4096
# EXTRACT context window in tokens when EXTRACT is bound to native Ollama; other bindings ignore it. The default fits the extraction prompt, gleaning pass, merge summaries and output cap. Overrides Ollama's VRAM-based default and OLLAMA_CONTEXT_LENGTH. Must be an integer.
LIGHTRAG_EXTRACT_OLLAMA_LLM_NUM_CTX=16384
# Optional EXTRACT role LLM concurrency. Empty = inherit MAX_ASYNC_LLM.
LIGHTRAG_EXTRACT_MAX_ASYNC_LLM=
# Optional KEYWORD role LLM concurrency. Empty = inherit MAX_ASYNC_LLM.
LIGHTRAG_KEYWORD_MAX_ASYNC_LLM=
# Optional QUERY role LLM concurrency. Empty = inherit MAX_ASYNC_LLM.
LIGHTRAG_QUERY_MAX_ASYNC_LLM=
# Optional EXTRACT role LLM timeout in seconds. Empty = inherit LLM_TIMEOUT.
LIGHTRAG_EXTRACT_LLM_TIMEOUT=
# Optional KEYWORD role LLM timeout in seconds. Empty = inherit LLM_TIMEOUT.
LIGHTRAG_KEYWORD_LLM_TIMEOUT=
# Optional QUERY role LLM timeout in seconds. Empty = inherit LLM_TIMEOUT.
LIGHTRAG_QUERY_LLM_TIMEOUT=
# LightRAG query default for reranking. Atlas keeps this false by default because direct LightRAG→TEI rerank payloads are incompatible without an adapter.
LIGHTRAG_QUERY_ENABLE_RERANK=false
# LightRAG query TOP_K. Atlas defaults this to a concrete integer because LightRAG v1.5.4 crashes when this env var is present but empty.
LIGHTRAG_QUERY_TOP_K=10
# LightRAG query CHUNK_TOP_K. Atlas defaults this to a concrete integer because LightRAG v1.5.4 crashes when this env var is present but empty.
LIGHTRAG_QUERY_CHUNK_TOP_K=5
# LightRAG query MAX_TOTAL_TOKENS. Atlas defaults this to a concrete integer because LightRAG v1.5.4 crashes when this env var is present but empty.
LIGHTRAG_QUERY_MAX_TOTAL_TOKENS=12000
# LightRAG embedding binding (EMBEDDING_BINDING). Default openai, through LiteLLM.
LIGHTRAG_EMBEDDING_BINDING=openai
# LightRAG embedding endpoint (EMBEDDING_BINDING_HOST). Default: the in-network LiteLLM.
LIGHTRAG_EMBEDDING_BINDING_HOST=http://litellm:4000/v1
# Empty = lightrag-init resolves from LITELLM_EMBEDDING_MODEL.
LIGHTRAG_EMBEDDING_MODEL=
# Empty = auto (lightrag-init probes the embedding model's true dimension). Set ONLY to force a value — a wrong dim writes a mismatched PGVector index and every insert fails.
LIGHTRAG_EMBEDDING_DIM=
# Passed as VLM_PROCESS_ENABLE: process images and figures with a vision LLM during document parsing.
LIGHTRAG_VLM_PROCESS_ENABLE=true
# LightRAG KV storage class. Default RedisKVStorage needs Redis; set a local class such as JsonKVStorage to run without it.
LIGHTRAG_KV_STORAGE=RedisKVStorage
# LightRAG vector storage class. Default PGVectorStorage needs Supabase; set a local class such as NanoVectorDBStorage to run without it.
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
# LightRAG graph storage class. Default Neo4JStorage needs Neo4j; set a local class such as NetworkXStorage to run without it.
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
# LightRAG document-status storage class. Default RedisDocStatusStorage needs Redis; set a local class such as JsonDocStatusStorage to run without it.
LIGHTRAG_DOC_STATUS_STORAGE=RedisDocStatusStorage
# Set by ./start.sh from LIGHTRAG_SOURCE; do not edit. 1 runs the lightrag container only for the container source, else 0.
# (auto-managed)
LIGHTRAG_SCALE=
# Set by ./start.sh from LIGHTRAG_SOURCE; do not edit. 1 runs lightrag-init only for the container source, else 0.
# (auto-managed)
LIGHTRAG_INIT_SCALE=
# Consumed by hermes/n8n/backend runtime_adaptive and LiteLLM model_list.
# (auto-managed)
LIGHTRAG_ENDPOINT=
# Set by ./start.sh; do not edit. The backend rerank adapter URL when LIGHTRAG_RERANK_ADAPTER_ENABLED=true and TEI is enabled; empty otherwise.
# (auto-managed)
LIGHTRAG_RERANK_BINDING_HOST=
# Always null by default. Direct LightRAG→TEI rerank payloads are incompatible without an adapter, and LightRAG crashes on an empty value.
# (auto-managed)
LIGHTRAG_RERANK_BINDING=
# Set by ./start.sh; do not edit. The docling-lightrag-adapter URL when LightRAG runs as a container and the adapter runs; empty otherwise.
# (auto-managed)
LIGHTRAG_DOCLING_ENDPOINT=
# Set by ./start.sh; do not edit. PostgreSQL DSN for LightRAG's scoped role on supabase-db; empty when Supabase is disabled.
# (auto-managed)
LIGHTRAG_PG_URI=
# Set by ./start.sh; do not edit. Source-aware Neo4j Bolt URI; empty when Neo4j is disabled.
# (auto-managed)
LIGHTRAG_NEO4J_URI=
# Set by ./start.sh; do not edit. Neo4j user for LightRAG graph storage; empty when Neo4j is disabled.
# (auto-managed)
LIGHTRAG_NEO4J_USERNAME=
# Set by ./start.sh from GRAPH_DB_PASSWORD; do not edit. Empty when Neo4j is disabled.
# (auto-managed)
LIGHTRAG_NEO4J_PASSWORD=
# Set by ./start.sh; do not edit. Redis URI (db 2) for LightRAG KV and document-status storage; empty when Redis is disabled.
# (auto-managed)
LIGHTRAG_REDIS_URI=

# ──────────────────────────────────────────────────────────────────────────
# llm: LiteLLM gateway (LLM router)  (services/litellm/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Image references
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.83.14-stable.patch.2

# Locked. LiteLLM is mandatory; only one source value supported.
LITELLM_SOURCE=container
# Host port for the LiteLLM gateway API and UI (in-container 4000).
LITELLM_PORT=63040
# Init container always runs (single value).
LITELLM_INIT_SCALE=1
# Auto-generated by bootstrapper on first run. Doubles as the admin-dashboard password.
# (secret)
LITELLM_MASTER_KEY=
# Admin-dashboard login username at http://litellm.localhost:${KONG_HTTP_PORT}/ui/. Password is LITELLM_MASTER_KEY.
LITELLM_UI_USERNAME=admin
# Lifetime in seconds of a cached LiteLLM response in Redis. Embeddings, reranks and transcriptions are cached, and chat with LITELLM_CACHE_CHAT=true. LiteLLM's own default is 60s. A non-numeric or non-positive value falls back to 3600.
LITELLM_CACHE_TTL=3600
# Key prefix for LiteLLM's Redis response cache. Redis db 0 also holds the n8n and Langfuse queues and the backend media store. The prefix keeps gateway cache keys separately scannable and droppable.
LITELLM_CACHE_NAMESPACE=litellm.cache
# Also cache chat, text completion and Responses API calls. Off by default, because a cached reply silently replaces a fresh hermes-agent or lightrag passthrough run, such as a query over newly ingested documents.
LITELLM_CACHE_CHAT=false
# Postgres database for LiteLLM. Supabase db-init (05-scoped-roles.sh) creates it.
LITELLM_DB_NAME=litellm
# Bootstrapper-synchronized percent-encoded LITELLM_DB_NAME for DSN path components.
LITELLM_DB_NAME_URI=litellm
# Scoped Postgres login that owns LITELLM_DB_NAME. Supabase db-init (05-scoped-roles.sh) creates it.
LITELLM_DB_USER=litellm
# Auto-generated password for the owner of LiteLLM's dedicated database.
# (secret)
LITELLM_DB_PASSWORD=atlas-db-password
# Bootstrapper-synchronized percent-encoded LITELLM_DB_USER for DSN userinfo.
LITELLM_DB_USER_URI=litellm
# Bootstrapper-synchronized percent-encoded LITELLM_DB_PASSWORD for DSN userinfo.
# (secret)
LITELLM_DB_PASSWORD_URI=atlas-db-password
# Default embedding model used by weaviate-init when computing collection vectorizers.
LITELLM_EMBEDDING_MODEL=ollama/nomic-embed-text
# Optional default chat model passed to LangMem (backend).
LITELLM_DEFAULT_MODEL=ollama/qwen3.8:latest
# Default vision-capable model (resolved from the model catalog; forward-looking — no consumer routes on it yet).
LITELLM_VISION_MODEL=ollama/qwen3.8:latest
# In-network URL consumers point at (backend, n8n, jupyterhub, open-webui).
# (auto-managed)
LITELLM_BASE_URL=

# ──────────────────────────────────────────────────────────────────────────
# apps: Neo4j LLM Graph Builder  (services/llm-graph-builder/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
LLM_GRAPH_BUILDER_SOURCE=disabled

# Pinned upstream neo4j-labs/llm-graph-builder git ref used by the source-build containers.
LLM_GRAPH_BUILDER_REF=4a412f4688cf4096976045c019edc0a7f6ddcb6b
# Host port for the Graph Builder frontend (in-container 8080).
LLM_GRAPH_BUILDER_PORT=63095
# Model id shown in the Graph Builder UI. Keep atlas_litellm: compose only exports LLM_MODEL_CONFIG_ATLAS_LITELLM, and Graph Builder reads LLM_MODEL_CONFIG_<ID>, so another id breaks extraction and chat.
LLM_GRAPH_BUILDER_MODEL_ID=atlas_litellm
# LiteLLM model alias used behind atlas_litellm. Empty = use LITELLM_DEFAULT_MODEL, then gpt-4o-mini (needs an OpenAI key).
LLM_GRAPH_BUILDER_LLM_MODEL=
# Neo4j database name for Graph Builder data. Use a dedicated database on editions that support it.
LLM_GRAPH_BUILDER_NEO4J_DATABASE=neo4j
# Optional Diffbot API key for upstream Diffbot extraction/model features. Atlas' default LiteLLM path does not require it.
# (secret)
LLM_GRAPH_BUILDER_DIFFBOT_API_KEY=
# Enable the upstream Google Cloud logging integration. Requires project id and an ADC credential file.
LLM_GRAPH_BUILDER_GCP_LOG_METRICS_ENABLED=false
# Store uploaded and failed files in GCS instead of local container storage. Requires the full GCP and bucket configuration.
LLM_GRAPH_BUILDER_GCS_FILE_CACHE=false
# Google Cloud project id used by optional GCS caching and Cloud logging.
LLM_GRAPH_BUILDER_GCP_PROJECT_ID=
# GCS bucket for uploaded files when LLM_GRAPH_BUILDER_GCS_FILE_CACHE=true.
LLM_GRAPH_BUILDER_GCS_UPLOAD_BUCKET=
# GCS bucket for failed files when LLM_GRAPH_BUILDER_GCS_FILE_CACHE=true.
LLM_GRAPH_BUILDER_GCS_FAILED_BUCKET=
# Absolute host path to a Google ADC JSON file. Mounted read-only only for the Graph Builder backend.
LLM_GRAPH_BUILDER_GCP_CREDENTIALS_FILE=
# Comma-separated upstream source picker values compiled into the frontend.
LLM_GRAPH_BUILDER_REACT_APP_SOURCES=local,wiki,web
# Comma-separated chat modes compiled into the frontend.
LLM_GRAPH_BUILDER_CHAT_MODES=vector,graph_vector,graph,fulltext,graph_vector_fulltext,entity_vector,global_vector
# Frontend build argument VITE_TIME_PER_PAGE (upstream setting). Changing it requires an image rebuild.
LLM_GRAPH_BUILDER_TIME_PER_PAGE=50
# Frontend build argument VITE_CHUNK_SIZE (upstream setting). Changing it requires an image rebuild.
LLM_GRAPH_BUILDER_CHUNK_SIZE=5242880
# Frontend build argument VITE_LARGE_FILE_SIZE (upstream setting). Changing it requires an image rebuild.
LLM_GRAPH_BUILDER_LARGE_FILE_SIZE=5242880
# Frontend build argument VITE_BATCH_SIZE (upstream setting). Changing it requires an image rebuild.
LLM_GRAPH_BUILDER_BATCH_SIZE=2
# Frontend build argument VITE_CHUNK_OVERLAP (upstream setting). Changing it requires an image rebuild.
LLM_GRAPH_BUILDER_CHUNK_OVERLAP=20
# Frontend build argument VITE_TOKENS_PER_CHUNK (upstream setting). Changing it requires an image rebuild.
LLM_GRAPH_BUILDER_TOKENS_PER_CHUNK=200
# Frontend build argument VITE_CHUNK_TO_COMBINE (upstream setting). Changing it requires an image rebuild.
LLM_GRAPH_BUILDER_CHUNK_TO_COMBINE=1
# Passed to the Graph Builder backend as MAX_TOKEN_CHUNK_SIZE (upstream setting).
LLM_GRAPH_BUILDER_MAX_TOKEN_CHUNK_SIZE=10000
# Passed to the Graph Builder backend as KNN_MIN_SCORE (upstream setting).
LLM_GRAPH_BUILDER_KNN_MIN_SCORE=0.94
# Passed to the Graph Builder backend as UPDATE_GRAPH_CHUNKS_PROCESSED (upstream setting).
LLM_GRAPH_BUILDER_UPDATE_GRAPH_CHUNKS_PROCESSED=20
# Passed to the Graph Builder backend as ENTITY_EMBEDDING (upstream setting).
LLM_GRAPH_BUILDER_ENTITY_EMBEDDING=false
# Passed to the Graph Builder backend as ENABLE_USER_AGENT (upstream setting).
LLM_GRAPH_BUILDER_ENABLE_USER_AGENT=true
# Passed to the Graph Builder backend as USER_AGENT (upstream setting).
LLM_GRAPH_BUILDER_USER_AGENT=Atlas-LLM-Graph-Builder
# Passed to the Graph Builder backend as TRACK_USER_USAGE (upstream setting).
LLM_GRAPH_BUILDER_TRACK_USER_USAGE=false
# Passed to the Graph Builder backend as AUTHENTICATION_REQUIRED (upstream setting): upstream backend authentication; Atlas keeps it false and relies on Kong Basic Auth.
LLM_GRAPH_BUILDER_AUTHENTICATION_REQUIRED=false
# Set by ./start.sh from LLM_GRAPH_BUILDER_SOURCE; do not edit. 1 runs llm-graph-builder-backend, 0 does not.
# (auto-managed)
LLM_GRAPH_BUILDER_BACKEND_SCALE=
# Set by ./start.sh from LLM_GRAPH_BUILDER_SOURCE; do not edit. 1 runs llm-graph-builder-frontend, 0 does not.
# (auto-managed)
LLM_GRAPH_BUILDER_FRONTEND_SCALE=
# Internal frontend URL.
# (auto-managed)
LLM_GRAPH_BUILDER_ENDPOINT=
# Internal backend API URL.
# (auto-managed)
LLM_GRAPH_BUILDER_BACKEND_ENDPOINT=
# Model config consumed as LLM_MODEL_CONFIG_ATLAS_LITELLM by the upstream backend.
# (auto-managed)
LLM_GRAPH_BUILDER_LITELLM_MODEL_CONFIG=

# ──────────────────────────────────────────────────────────────────────────
# apps: Local Deep Researcher (LangGraph research agent)  (services/local-deep-researcher/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
LOCAL_DEEP_RESEARCHER_SOURCE=container

# Image references
LOCAL_DEEP_RESEARCHER_IMAGE=python:3.11.15-slim

# Host port for the Local Deep Researcher LangGraph API (in-container 2024).
LOCAL_DEEP_RESEARCHER_PORT=63097
# Full upstream local-deep-researcher commit SHA materialized into the managed repo volume. Update deliberately after compatibility validation; runtime startup never follows a branch.
LOCAL_DEEP_RESEARCHER_REF=38f769f84380f2065de76021ac7c5215f88aa39e
# Exact langgraph-cli[inmem] version used to serve the pinned source tree.
LOCAL_DEEP_RESEARCHER_LANGGRAPH_CLI_VERSION=0.4.31
# SHA-256 digest of uv.lock at LOCAL_DEEP_RESEARCHER_REF; startup rejects a source tree whose lock does not match.
LOCAL_DEEP_RESEARCHER_UPSTREAM_LOCK_SHA256=26fc35ac377836de6628e5f7b180944c4d4bd50a5e9f0200bd6e663f20e35c1a
# Maximum web research loops per run, passed as MAX_WEB_RESEARCH_LOOPS.
LOCAL_DEEP_RESEARCHER_LOOPS=3
# Web search backend, passed as SEARCH_API. Default searxng.
LOCAL_DEEP_RESEARCHER_SEARCH_API=searxng
# Reserved: passed to the container, but the entrypoint does not pass it to langgraph dev. One server process owns the in-memory research state.
LOCAL_DEEP_RESEARCHER_WORKERS=3
# Full-page extraction mode: disabled, builtin, or crawl4ai. The crawl4ai mode requires CRAWL4AI_SOURCE=container.
LOCAL_DEEP_RESEARCHER_FULL_PAGE_MODE=disabled
# Set by ./start.sh from LOCAL_DEEP_RESEARCHER_FULL_PAGE_MODE; do not edit. true for builtin or crawl4ai, false for disabled.
# (auto-managed)
FETCH_FULL_PAGE=
# Set by ./start.sh from LOCAL_DEEP_RESEARCHER_SOURCE; do not edit. 0 when disabled, else 1.
# (auto-managed)
LOCAL_DEEP_RESEARCHER_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# infra: Loki (queryable log store)  (services/loki/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
LOKI_SOURCE=disabled

# Image references
LOKI_IMAGE=grafana/loki:3.7.0

# Set by ./start.sh from LOKI_SOURCE; do not edit. 1 runs loki, 0 does not.
# (auto-managed)
LOKI_SCALE=
# Internal Loki API endpoint consumed by Grafana.
# (auto-managed)
LOKI_ENDPOINT=
# Short local retention period for Loki compactor-managed log deletion.
LOKI_RETENTION_PERIOD=24h

# ──────────────────────────────────────────────────────────────────────────
# agents: Curated MCP Servers  (services/mcp-servers/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
MCP_SERVERS_SOURCE=disabled

# Image references
# Used as build-arg BASE_IMAGE in build/Dockerfile.
MCP_SERVERS_IMAGE=python:3.12.14-slim

# Read-only PostgreSQL login for the curated MCP query tool.
MCP_POSTGRES_DB_USER=atlas_mcp
# Auto-generated password for the MCP read-only database role.
# (secret)
MCP_POSTGRES_DB_PASSWORD=atlas-db-password
# Host port for the curated MCP Streamable HTTP endpoint (container port 8000).
MCP_SERVERS_PORT=63078
# Replicas: 1 when MCP_SERVERS_SOURCE=container, else 0.
# (auto-managed)
MCP_SERVERS_SCALE=
# Maximum rows returned by the Postgres MCP query tool.
MCP_POSTGRES_MAX_ROWS=50
# Maximum rows returned by the Neo4j MCP query tool. Empty falls back to MCP_POSTGRES_MAX_ROWS (default 50).
MCP_NEO4J_MAX_ROWS=
# Maximum SearXNG results returned by the web-search MCP tool.
MCP_SEARXNG_MAX_RESULTS=5
# Timeout for upstream database/search calls made by MCP tools.
MCP_TOOL_TIMEOUT_SECONDS=15

# ──────────────────────────────────────────────────────────────────────────
# data: MinIO (S3-compatible object storage)  (services/minio/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
MINIO_SOURCE=container

# Image references
# Silo, the Pigsty-maintained AGPL fork of the archived MinIO community server, pinned by tag and multi-arch digest. It keeps the MINIO_* environment, /minio/* routes, mc admin API and on-disk format. Its entrypoint maps `server` to `silo server`, so the compose command is unchanged. It carries the bounded S3 Select CSV reader fix for CVE-2026-39414. Review upstream security advisories before bumping.
MINIO_IMAGE=pgsty/silo:RELEASE.2026-09-16T00-00-00Z@sha256:635197cb9f36d01bee221d34d1c7d7960f6a95c48b0b6c01d99cd13bdae51a46
MINIO_INIT_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z@sha256:cfc83108c3abb371f8fb84d99c1fdc88f8c237e022409b0081fb7c0a3be634dd

# Host port for the MinIO S3 API (in-container listen port is 9000).
MINIO_PORT=63020
# Host port for the MinIO admin console (in-container listen port is 9001).
MINIO_CONSOLE_PORT=63021
# MinIO root username. minio-init, airflow and backup also receive it; consumer services use their own scoped access keys.
MINIO_ROOT_USER=minioadmin
# Auto-generated by bootstrapper KeyGenerator.generate_minio_root_password().
# (secret)
MINIO_ROOT_PASSWORD=
# S3 region MinIO reports. Clients such as iceberg-rest, jupyterhub, langfuse, label-studio and the asset services use it as their S3 region.
MINIO_REGION=us-east-1
# Auto-managed by minio. Container/disabled.
MINIO_INIT_SOURCE=container
# Set by ./start.sh from MINIO_SOURCE; do not edit. 1 runs the minio container, 0 does not.
# (auto-managed)
MINIO_SCALE=
# Set by ./start.sh from MINIO_SOURCE; do not edit. 1 runs the minio-init container, 0 does not.
# (auto-managed)
MINIO_INIT_SCALE=
# In-network URL (S3 API).
# (auto-managed)
MINIO_ENDPOINT=
# Host-side URL (for browser redirects).
# (auto-managed)
MINIO_PUBLIC_ENDPOINT=
# Derived by ./start.sh; do not set. Host URL of the MinIO console (http://localhost:${MINIO_CONSOLE_PORT}), empty when disabled. Passed to MinIO as MINIO_BROWSER_REDIRECT_URL.
# (auto-managed)
MINIO_PUBLIC_CONSOLE_ENDPOINT=
# Optional space-separated parent-owned MinIO entries using CONSUMER:BUCKET_VAR:ACCESS_VAR:SECRET_VAR[:RW_BUCKET_VAR,...[:RO_BUCKET_VAR,...]] grammar for services/_user overlays.
MINIO_EXTRA_CONSUMERS=
# Shared input bucket for the Asset Worker and Asset Baker scoped service accounts.
MINIO_BUCKET_ASSET_INPUTS=raw-assets
# Auto-generated scoped MinIO access key for writing shared raw asset inputs.
# (secret)
MINIO_ASSET_INGEST_ACCESS_KEY=
# Auto-generated scoped MinIO secret key for writing shared raw asset inputs.
# (secret)
MINIO_ASSET_INGEST_SECRET_KEY=
# Auto-generated scoped MinIO access key for Asset Worker input and output buckets.
# (secret)
MINIO_ASSET_WORKER_ACCESS_KEY=
# Auto-generated scoped MinIO secret key for Asset Worker input and output buckets.
# (secret)
MINIO_ASSET_WORKER_SECRET_KEY=
# Auto-generated scoped MinIO access key for Asset Baker input and output buckets.
# (secret)
MINIO_ASSET_BAKER_ACCESS_KEY=
# Auto-generated scoped MinIO secret key for Asset Baker input and output buckets.
# (secret)
MINIO_ASSET_BAKER_SECRET_KEY=
# Bucket minio-init creates for the comfyui service account.
MINIO_BUCKET_COMFYUI=comfyui
# Auto-generated scoped MinIO access key for the comfyui bucket.
# (secret)
MINIO_COMFYUI_ACCESS_KEY=
# Auto-generated scoped MinIO secret key for the comfyui bucket.
# (secret)
MINIO_COMFYUI_SECRET_KEY=
# Bucket minio-init creates for the backend service account.
MINIO_BUCKET_BACKEND=backend
# Auto-generated scoped MinIO access key for the backend bucket.
# (secret)
MINIO_BACKEND_ACCESS_KEY=
# Auto-generated scoped MinIO secret key for the backend bucket.
# (secret)
MINIO_BACKEND_SECRET_KEY=
# Bucket minio-init creates for the n8n service account.
MINIO_BUCKET_N8N=n8n
# Auto-generated scoped MinIO access key for the n8n bucket.
# (secret)
MINIO_N8N_ACCESS_KEY=
# Auto-generated scoped MinIO secret key for the n8n bucket.
# (secret)
MINIO_N8N_SECRET_KEY=
# Bucket minio-init creates for the jupyter service account, which can also read the Iceberg lakehouse bucket.
MINIO_BUCKET_JUPYTER=jupyter
# Auto-generated scoped MinIO access key for the jupyter bucket.
# (secret)
MINIO_JUPYTER_ACCESS_KEY=
# Auto-generated scoped MinIO secret key for the jupyter bucket.
# (secret)
MINIO_JUPYTER_SECRET_KEY=
# Spark event-log bucket used by Zeppelin and the Spark History Server.
MINIO_BUCKET_SPARK_HISTORY=spark-history
# Auto-generated scoped MinIO access key for Spark event logs and lakehouse workflow buckets.
# (secret)
MINIO_SPARK_ACCESS_KEY=
# Auto-generated scoped MinIO secret key for Spark event logs and lakehouse workflow buckets.
# (secret)
MINIO_SPARK_SECRET_KEY=
# Bucket minio-init creates for the docling service account.
MINIO_BUCKET_DOCLING=docling
# Auto-generated scoped MinIO access key for the docling bucket.
# (secret)
MINIO_DOCLING_ACCESS_KEY=
# Auto-generated scoped MinIO secret key for the docling bucket.
# (secret)
MINIO_DOCLING_SECRET_KEY=
# Bucket minio-init creates for the langfuse service account. Langfuse uses it for event, media and batch-export uploads.
MINIO_BUCKET_LANGFUSE=langfuse
# Auto-generated scoped MinIO access key for the langfuse bucket.
# (secret)
MINIO_LANGFUSE_ACCESS_KEY=
# Auto-generated scoped MinIO secret key for the langfuse bucket.
# (secret)
MINIO_LANGFUSE_SECRET_KEY=
# Bucket minio-init creates for the mlflow service account. MLflow stores run artifacts in it.
MINIO_BUCKET_MLFLOW=mlflow
# Auto-generated scoped MinIO access key for the mlflow bucket.
# (secret)
MINIO_MLFLOW_ACCESS_KEY=
# Auto-generated scoped MinIO secret key for the mlflow bucket.
# (secret)
MINIO_MLFLOW_SECRET_KEY=
# Bucket minio-init creates for the label-studio service account. Label Studio uses it as its storage bucket.
MINIO_BUCKET_LABEL_STUDIO=label-studio
# Auto-generated scoped MinIO access key for the label-studio bucket.
# (secret)
MINIO_LABEL_STUDIO_ACCESS_KEY=
# Auto-generated scoped MinIO secret key for the label-studio bucket.
# (secret)
MINIO_LABEL_STUDIO_SECRET_KEY=
# Iceberg warehouse bucket. The iceberg and spark service accounts can write it; the jupyter account can read it.
MINIO_BUCKET_ICEBERG_LAKEHOUSE=lakehouse
# Jar bucket for Spark jobs. The spark and iceberg service accounts can write it; Airflow and Jenkins receive its name.
MINIO_BUCKET_ICEBERG_JARS=jars
# Checkpoint bucket. The spark and iceberg service accounts can write it; Zeppelin and JupyterHub receive its name.
MINIO_BUCKET_ICEBERG_CHECKPOINTS=checkpoints
# Landing bucket. The spark and iceberg service accounts can write it; Airflow, Zeppelin and JupyterHub receive its name.
MINIO_BUCKET_ICEBERG_LANDING=landing
# Auto-generated scoped MinIO access key for the Iceberg lakehouse buckets.
# (secret)
MINIO_ICEBERG_ACCESS_KEY=
# Auto-generated scoped MinIO secret key for the Iceberg lakehouse buckets.
# (secret)
MINIO_ICEBERG_SECRET_KEY=

# ──────────────────────────────────────────────────────────────────────────
# apps: MLflow (experiment tracking + artifacts)  (services/mlflow/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
MLFLOW_SOURCE=disabled

# Image references
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.16.1
MLFLOW_INIT_IMAGE=alpine:3.24.2

# Host port for the MLflow UI/API (in-container 5000).
MLFLOW_PORT=63092
# In-network URL for Atlas services and notebooks.
# (auto-managed)
MLFLOW_ENDPOINT=
# Tracking URI injected into JupyterHub when MLflow is enabled.
# (auto-managed)
MLFLOW_TRACKING_URI=
# Set by ./start.sh from MLFLOW_SOURCE; do not edit. 1 runs the mlflow container, 0 does not.
# (auto-managed)
MLFLOW_SCALE=
# Set by ./start.sh from MLFLOW_SOURCE; do not edit. 1 runs the mlflow-init container, 0 does not.
# (auto-managed)
MLFLOW_INIT_SCALE=
# Postgres database in supabase-db that holds the MLflow tracking and model-registry stores.
MLFLOW_DB_NAME=mlflow
# Bootstrapper-synchronized percent-encoded MLFLOW_DB_NAME for DSN path components.
MLFLOW_DB_NAME_URI=mlflow
# Restricted Postgres login that owns the MLflow database; created by 05-scoped-roles.sh.
MLFLOW_DB_USER=mlflow
# Auto-generated Postgres password for the dedicated MLflow database role.
# (secret)
MLFLOW_DB_PASSWORD=atlas-db-password
# Bootstrapper-synchronized percent-encoded MLFLOW_DB_USER for DSN userinfo.
MLFLOW_DB_USER_URI=mlflow
# Bootstrapper-synchronized percent-encoded MLFLOW_DB_PASSWORD for DSN userinfo.
# (secret)
MLFLOW_DB_PASSWORD_URI=atlas-db-password

# ──────────────────────────────────────────────────────────────────────────
# agents: n8n (workflow automation)  (services/n8n/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
N8N_SOURCE=container

# Image references
N8N_IMAGE=n8nio/n8n:2.28.2
N8N_INIT_IMAGE=n8nio/n8n:2.28.2

# Owner of the isolated n8n schema in Supabase PostgreSQL.
N8N_DB_USER=atlas_n8n
# Auto-generated password for the scoped n8n database role.
# (secret)
N8N_DB_PASSWORD=atlas-db-password
# Host port for the n8n editor and webhooks (container port 5678).
N8N_PORT=63075
# Encryption key for n8n credentials and workflow secrets; auto-generated by the bootstrapper when left as the placeholder.
# (secret)
N8N_ENCRYPTION_KEY=your-random-encryption-key
# n8n public-API key (n8n CE issues these only via the UI: Settings → n8n API). Consumed by the backend's /workflows endpoints; while empty those endpoints currently return backend errors from failed upstream n8n calls.
# (secret)
N8N_API_KEY=
# Not interpolated: the n8n compose fragment sets N8N_HOST=n8n.localhost directly.
N8N_HOST=n8n.localhost
# Protocol n8n uses in the URLs it generates (N8N_PROTOCOL in the n8n and n8n-worker containers).
N8N_PROTOCOL=http
# n8n EXECUTIONS_MODE. The default queue runs workflow executions on n8n-worker through Redis.
N8N_EXECUTIONS_MODE=queue
# Init-container selector listed in the SOURCE values reference. N8N_INIT_SCALE follows N8N_SOURCE, so n8n-init runs whenever n8n runs.
N8N_INIT_SOURCE=container
# Exact community package specs installed before n8n starts. Atlas' default ComfyUI set uses the committed package-lock; n8n 2.28.2 already supplies first-party MCP nodes. Custom values must use name@x.y.z for every comma-separated package.
N8N_INIT_NODES=n8n-nodes-comfyui@0.0.9,@ksc1234/n8n-nodes-comfyui-image-to-image@1.0.2
# Absolute deadline in milliseconds for each consumer workflow seeder HTTP operation; must be positive.
N8N_SEED_HTTP_TIMEOUT_MS=10000
# Deadline in milliseconds for each consumer workflow n8n CLI operation; must be positive.
N8N_SEED_COMMAND_TIMEOUT_MS=120000
# Maximum bytes accepted from one consumer workflow seeder HTTP response; must be positive.
N8N_SEED_MAX_RESPONSE_BYTES=1048576
# Set by ./start.sh from N8N_SOURCE; do not edit. 1 runs the n8n container, 0 does not.
# (auto-managed)
N8N_SCALE=
# Set by ./start.sh from N8N_SOURCE; do not edit. 1 runs the n8n-worker container, 0 does not.
# (auto-managed)
N8N_WORKER_SCALE=
# Set by ./start.sh from N8N_SOURCE; do not edit. 1 runs the n8n-init container, 0 does not.
# (auto-managed)
N8N_INIT_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# data: Neo4j (graph database)  (services/neo4j/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | localhost | disabled
NEO4J_GRAPH_DB_SOURCE=container

# Image references
# Used as build-arg BASE_IMAGE in graph-db/Dockerfile.
NEO4J_GRAPH_DB_IMAGE=neo4j:5.26.31

# Host port for Neo4j bolt (container port 7687).
GRAPH_DB_PORT=63023
# Host port for Neo4j browser dashboard (container port 7474).
GRAPH_DB_DASHBOARD_PORT=63024
# Neo4j username. Backend and jupyterhub receive it as NEO4J_USER, and airflow-init seeds it into neo4j_default. Keep it equal to the user in GRAPH_DB_AUTH.
GRAPH_DB_USER=neo4j
# Neo4j password; auto-generated by the bootstrapper when left as the placeholder.
# (secret)
GRAPH_DB_PASSWORD=neo4j_password
# Neo4j auth in username/password format.
# (secret)
GRAPH_DB_AUTH=neo4j/neo4j_password
# Computed from NEO4J_GRAPH_DB_SOURCE. Read by backend/jupyterhub.
# (auto-managed)
NEO4J_URI=
# Replicas: 1 for container, 0 otherwise.
# (auto-managed)
NEO4J_SCALE=
# Host HTTP port for the neo4j-localhost source variant (browser UI + REST). Kong route target is derived as http://host.docker.internal:7474.
NEO4J_LOCALHOST_HTTP_PORT=7474
# Host Bolt port for the neo4j-localhost source variant (driver protocol). NEO4J_URI is derived as bolt://host.docker.internal:7687. The wizard's inline-textbox edits THIS port (HTTP is overridable via .env hand-edit).
NEO4J_LOCALHOST_BOLT_PORT=7687
# Memory limit for neo4j-graph-db (deploy.resources.limits.memory). 2g is conservative for a 32 GB host. Single-node dev and staging workloads typically stay well under it.
NEO4J_MEMORY_LIMIT=2g
# Container CPU limit for neo4j-graph-db (deploy.resources.limits.cpus). 1.5 cores is sufficient for single-node Bolt + HTTP query serving.
NEO4J_CPU_LIMIT=1.5

# ──────────────────────────────────────────────────────────────────────────
# llm: Ollama (local LLM engine)  (services/ollama/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: ollama-container-cpu | ollama-container-gpu | ollama-localhost | none
LLM_PROVIDER_SOURCE=ollama-container-cpu

# Image references
LLM_PROVIDER_IMAGE=ollama/ollama:0.30.11
OLLAMA_PULL_IMAGE=alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

# Comma-separated Ollama model names to activate/pull. Pre-filled by env_assembler from the catalog's default-active Ollama set (see services/ollama/models.yaml); the wizard overwrites it with the user's selection.
OLLAMA_USER_MODELS=qwen3.8:latest,nomic-embed-text,qwen3-embedding:0.6b
# Free-text extra Ollama models; a consumer's model_sidecars.ollama lands here. The ollama-pull init container pulls them for container-* sources, and ./start.sh pulls them onto the host daemon for ollama-localhost.
OLLAMA_CUSTOM_MODELS=
# Seconds an ollama-pull download may stay below 1 KiB/s before it is aborted and retried. A download that keeps progressing has no wall-clock cutoff.
OLLAMA_PULL_STALL_TIMEOUT_SECONDS=120
# When LLM_PROVIDER_SOURCE=ollama-localhost, litellm-init queries the upstream's /api/tags and auto-imports every model found, unioning with OLLAMA_USER_MODELS. Set false to keep strict wizard-only control.
OLLAMA_AUTO_IMPORT_LOCAL_MODELS=true
# Reserved for future GPU deploy block. Currently '~' (null).
OLLAMA_DEPLOY_RESOURCES=~
# Set by ./start.sh from LLM_PROVIDER_SOURCE; do not edit. 1 runs the ollama container (container-* sources), 0 does not.
# (auto-managed)
OLLAMA_SCALE=
# Set by ./start.sh from LLM_PROVIDER_SOURCE; do not edit. 1 runs the ollama-pull init container for container-* sources, else 0.
# (auto-managed)
OLLAMA_PULL_SCALE=
# Set by ./start.sh from LLM_PROVIDER_SOURCE; do not edit. all for ollama-container-gpu, else null. Passed to the ollama container as NVIDIA_VISIBLE_DEVICES.
# (auto-managed)
OLLAMA_NVIDIA_VISIBLE_DEVICES=
# Auto-managed; do not set. The per-source Ollama URL (empty for none). ./start.sh writes it into LITELLM_OLLAMA_UPSTREAM; no container reads OLLAMA_ENDPOINT directly.
# (auto-managed)
OLLAMA_ENDPOINT=
# Ollama URL the LiteLLM gateway forwards Ollama-routed requests to. Owned by ollama because the value flips with LLM_PROVIDER_SOURCE; consumed by litellm-init when rendering its config.yaml.
# (auto-managed)
LITELLM_OLLAMA_UPSTREAM=
# Host port for the ollama-localhost source variant. URL is derived at compose-render time as http://host.docker.internal:11434.
OLLAMA_LOCALHOST_PORT=11434
# Ollama parallel request slots per model. Multi-agent consumers (8+ concurrent requests) need more than 1; Ollama's default of 1 serializes them. Applies to the container-* sources; for ollama-localhost the host daemon owns it.
OLLAMA_NUM_PARALLEL=8
# Maximum models Ollama keeps resident at once. Raise it for workloads that swap between several models; lower it to bound memory. Applies to the container-* sources; for ollama-localhost the host daemon owns it.
OLLAMA_MAX_LOADED_MODELS=2
# KV cache quantization: f16 (full precision, Ollama's default), q8_0 (about half the memory, negligible quality cost) or q4_0 (about a quarter, measurable cost). Needs OLLAMA_FLASH_ATTENTION active. Container-* sources only; ollama-localhost uses the host daemon's setting.
OLLAMA_KV_CACHE_TYPE=q8_0
# Enables Ollama's flash-attention path. Current Ollama enables it automatically where supported. Atlas pins it because OLLAMA_KV_CACHE_TYPE quantization has no effect without it. Set 0 to force it off.
OLLAMA_FLASH_ATTENTION=1
# Time Ollama keeps a model loaded after its last use (5m, 1h, or -1 for forever); empty uses Ollama's 5m default. Container-* sources only. -1 keeps every loaded model in RAM until reverted and the daemon restarts.
OLLAMA_KEEP_ALIVE=
# Advisory, ollama-localhost only: how many models a workload needs resident at once. ./start.sh doctor reports a failure when the daemon's OLLAMA_MAX_LOADED_MODELS is lower. Empty declares no expectation. A LightRAG run with separate extract, embed and keyword models needs 3.
OLLAMA_MODELS_RESIDENT_MIN=
# Advisory, ollama-localhost only: the concurrent-request floor a consumer needs. ./start.sh doctor warns when the daemon's OLLAMA_NUM_PARALLEL is lower. Empty declares no expectation. Ollama's default of 1 slot silently serializes a multi-agent consumer.
OLLAMA_PARALLEL_MIN=

# ──────────────────────────────────────────────────────────────────────────
# apps: Open WebUI (chat interface)  (services/open-webui/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
OPEN_WEB_UI_SOURCE=container

# Image references
OPEN_WEB_UI_IMAGE=dyrnq/open-webui:v0.6.32
OPEN_WEB_UI_INIT_IMAGE=python:3.12.14-slim-bookworm@sha256:0f5b26b9518d002b6173fd61daad821fa340635ebfec5bba471013f9ca114579

# Scoped PostgreSQL owner for Open WebUI migration objects.
OPEN_WEBUI_DB_USER=atlas_open_webui
# Auto-generated password for the scoped Open WebUI database role.
# (secret)
OPEN_WEBUI_DB_PASSWORD=atlas-db-password
# Bootstrapper-synchronized percent-encoded OPEN_WEBUI_DB_USER for DSN userinfo.
OPEN_WEBUI_DB_USER_URI=atlas_open_webui
# Bootstrapper-synchronized percent-encoded OPEN_WEBUI_DB_PASSWORD for DSN userinfo.
# (secret)
OPEN_WEBUI_DB_PASSWORD_URI=atlas-db-password
# Parakeet bearer token when a Parakeet source is selected; a non-secret compatibility placeholder for other enabled STT engines.
# (auto-managed, secret)
OPEN_WEB_UI_STT_API_KEY=
# Host port for the Open WebUI web interface (container port 8080).
OPEN_WEB_UI_PORT=63096
# Open WebUI session/signing secret; auto-generated by the bootstrapper when left as the placeholder.
# (secret)
OPEN_WEB_UI_SECRET_KEY=secret
# Email of the admin account that open-webui-init creates.
OPEN_WEB_UI_ADMIN_EMAIL=admin@localhost
# Initial Open WebUI admin password; auto-generated by the bootstrapper when left as the placeholder.
# (secret)
OPEN_WEB_UI_ADMIN_PASSWORD=admin
# Display name of the admin account that open-webui-init creates.
OPEN_WEB_UI_ADMIN_NAME=Admin
# Open WebUI ENABLE_WEBSOCKET_SUPPORT. The websocket manager uses Redis.
OPEN_WEB_UI_WEBSOCKET_SUPPORT=true
# Redis database index for Open WebUI's websocket manager. LightRAG shares db 2 by default.
OPEN_WEB_UI_REDIS_DB=2
# Seconds Open WebUI caches the model list (MODELS_CACHE_TTL).
OPEN_WEB_UI_MODEL_CACHE_TTL=300
# Set by bootstrapper: true unless COMFYUI_SOURCE=disabled, so Open WebUI hides its ComfyUI image toggle when there is no ComfyUI. Open WebUI keeps the value saved in its database once an admin edits the Images settings.
OPEN_WEB_UI_ENABLE_IMAGE_GENERATION=true
# Set by bootstrapper when speaches/chatterbox are enabled.
OPEN_WEB_UI_TTS_ENGINE=
# Set by ./start.sh: openai when STT_PROVIDER_SOURCE is not disabled, else empty. Passed as AUDIO_STT_ENGINE.
OPEN_WEB_UI_STT_ENGINE=
# Model name Open WebUI sends to /v1/audio/speech. Empty = engine default.
OPEN_WEB_UI_TTS_MODEL=
# Voice id. Empty = engine default.
OPEN_WEB_UI_TTS_VOICE=
# Set by ./start.sh from TTS_ENDPOINT plus /v1, or empty. Passed as AUDIO_TTS_OPENAI_API_BASE_URL.
# (auto-managed)
OPEN_WEB_UI_TTS_API_URL=
# Set by ./start.sh from STT_ENDPOINT plus /v1, or empty. Passed as AUDIO_STT_OPENAI_API_BASE_URL.
# (auto-managed)
OPEN_WEB_UI_STT_API_URL=
# Set by ./start.sh from OPEN_WEB_UI_SOURCE; do not edit. 1 runs the open-web-ui container, 0 does not.
# (auto-managed)
OPEN_WEB_UI_SCALE=
# Set by ./start.sh from OPEN_WEB_UI_SOURCE; do not edit. 1 runs the open-webui-init container, 0 does not.
# (auto-managed)
OPEN_WEB_UI_INIT_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# agents: OpenClaw (AI agent gateway)  (services/openclaw/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: disabled | container | localhost
OPENCLAW_SOURCE=disabled

# Image references
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.6.10
OPENCLAW_INIT_IMAGE=alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

# Host port for the OpenClaw gateway API and dashboard (container port 18789).
OPENCLAW_GATEWAY_PORT=63076
# Host port for the OpenClaw bridge (container port 18790).
OPENCLAW_BRIDGE_PORT=63077
# Auto-generated bearer token for the OpenClaw gateway API and dashboard; kept once set. The gateway binds to the LAN interface and refuses to do so without a token. Left empty, it would mint an unreadable per-start token.
# (secret)
OPENCLAW_GATEWAY_TOKEN=
# Host port for the localhost source variant (its own slot, separate from OPENCLAW_GATEWAY_PORT). URL is derived at compose-render time as http://host.docker.internal:63065.
OPENCLAW_LOCALHOST_PORT=63065
# Init-container selector listed in the SOURCE values reference. OPENCLAW_INIT_SCALE follows OPENCLAW_SOURCE, so openclaw-init runs only for container.
OPENCLAW_INIT_SOURCE=container
# Optional per-OpenClaw Anthropic override.
# (secret)
OPENCLAW_ANTHROPIC_API_KEY=
# Optional per-OpenClaw OpenAI override. Leave empty to keep OpenClaw routed through LiteLLM instead of bypassing the stack gateway.
# (secret)
OPENCLAW_OPENAI_API_KEY=
# Set by ./start.sh from OPENCLAW_SOURCE; do not edit. 1 runs the openclaw-gateway container for container, else 0.
# (auto-managed)
OPENCLAW_SCALE=
# Set by ./start.sh from OPENCLAW_SOURCE; do not edit. 1 runs the openclaw-init container for container, else 0.
# (auto-managed)
OPENCLAW_INIT_SCALE=
# Resolved per source by ./start.sh: the container DNS name, a host.docker.internal URL, or empty when disabled. No compose fragment injects it into a container; consumers wire it themselves.
# (auto-managed)
OPENCLAW_ENDPOINT=

# ──────────────────────────────────────────────────────────────────────────
# infra: OpenTelemetry Collector (telemetry ingest)  (services/otel-collector/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
OTEL_COLLECTOR_SOURCE=disabled

# Image references
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.154.0

# Set by ./start.sh from OTEL_COLLECTOR_SOURCE; do not edit. 1 runs the otel-collector container, 0 does not.
# (auto-managed)
OTEL_COLLECTOR_SCALE=
# Preferred internal OTLP HTTP endpoint for Atlas services.
# (auto-managed)
OTEL_COLLECTOR_ENDPOINT=
# Internal OTLP HTTP endpoint (`http://otel-collector:4318`) when enabled.
# (auto-managed)
OTEL_COLLECTOR_OTLP_HTTP_ENDPOINT=
# Internal OTLP gRPC endpoint (`http://otel-collector:4317`) when enabled.
# (auto-managed)
OTEL_COLLECTOR_OTLP_GRPC_ENDPOINT=
# Boolean string consumed by backend and LiteLLM tracing toggles.
# (auto-managed)
ATLAS_OTEL_ENABLED=

# ──────────────────────────────────────────────────────────────────────────
# media: Parakeet (NVIDIA STT engine)  (services/parakeet/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: speaches-container-cpu | speaches-container-gpu | parakeet-container-gpu | parakeet-localhost | whisper-cpp-localhost | disabled
STT_PROVIDER_SOURCE=speaches-container-cpu

# Image references
# Used as BASE_IMAGE in stt-provider/gpu/Dockerfile.
PARAKEET_GPU_IMAGE=nvcr.io/nvidia/pytorch:26.06-py3

# Wizard display slot. Real per-engine ports live on their own manifests (PARAKEET_*, SPEACHES_*, etc.).
STT_PROVIDER_PORT=63055
# Set by ./start.sh; do not edit. 1 when a container engine serves speech-to-text, else 0. The wizard uses it to colour the STT row.
# (auto-managed)
STT_PROVIDER_SCALE=
# Model the Parakeet GPU container loads (NeMo model ID), passed as PARAKEET_MODEL.
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3
# Torch device for the Parakeet GPU container, passed as PARAKEET_DEVICE.
PARAKEET_GPU_DEVICE=cuda
# Maximum audio upload size in bytes for the Parakeet GPU and localhost APIs. The request body is capped before multipart parsing, with 1 MiB added for framing. Larger requests return 413. An invalid value stops startup.
PARAKEET_MAX_UPLOAD_BYTES=104857600
# Total seconds (1-3600) allowed to receive one Parakeet upload body before a 408 response releases admission capacity.
PARAKEET_UPLOAD_TIMEOUT_SECONDS=120
# Maximum concurrent Parakeet inference calls per provider process. Default 1 prevents model thread-safety and GPU memory contention.
PARAKEET_CONCURRENCY=1
# Auto-generated bearer credential required by Parakeet routes except /health.
# (secret)
PARAKEET_API_TOKEN=
# Provider authentication mode: required (default) or disabled for an explicit emergency/local rollback.
PARAKEET_AUTH_MODE=required
# Optional comma-separated browser origin allowlist. Empty disables CORS; wildcard is invalid while authentication is required.
PARAKEET_CORS_ORIGINS=
# Finite model-load and transcription deadline in seconds (1-3600). A timeout returns 504 and then exits the provider process for restart.
PARAKEET_INFERENCE_TIMEOUT_SECONDS=900
# Native Parakeet listen address. Set another interface explicitly only when remote access is intended.
PARAKEET_LOCALHOST_BIND_HOST=127.0.0.1
# Host port for the parakeet-localhost source variant. URL is derived at compose-render time as http://host.docker.internal:63042.
PARAKEET_LOCALHOST_PORT=63042
# Host port for the whisper-cpp-localhost source variant, same as parakeet because the two modes are mutually exclusive. URL is derived at compose-render time as http://host.docker.internal:63042.
WHISPER_CPP_LOCALHOST_PORT=63042
# Shared by parakeet, speaches, chatterbox, docling for model downloads. Consumed by ${HUGGING_FACE_HUB_TOKEN} interpolation in those services' compose blocks; owned here as its historic home.
# (secret)
HUGGING_FACE_HUB_TOKEN=
# Set by ./start.sh from STT_PROVIDER_SOURCE; do not edit. 1 runs the parakeet-gpu container for parakeet-container-gpu, else 0.
# (auto-managed)
PARAKEET_GPU_SCALE=
# Resolved per STT_PROVIDER_SOURCE. Consumed by n8n, backend, jupyterhub, open-webui, hermes-init (the latter as STT_INTERNAL_URL — owned by services/hermes/).
# (auto-managed)
STT_ENDPOINT=

# ──────────────────────────────────────────────────────────────────────────
# infra: Prometheus (metrics scraper + TSDB)  (services/prometheus/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
PROMETHEUS_SOURCE=disabled

# Image references
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.11.1
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.55.1

# Host port for Prometheus's HTTP UI + API (in-container 9090).
PROMETHEUS_PORT=63006
# Host port for node-exporter (in-container 9100). Host-level metrics: CPU, memory, disk, network.
NODE_EXPORTER_PORT=63007
# Host port for cAdvisor (in-container 8080). Per-container metrics: CPU, memory, IO.
CADVISOR_PORT=63008
# TSDB retention in days. User-configurable at wizard time via the inline secondary numeric input. Default 7.
PROMETHEUS_RETENTION_DAYS=7
# Resolved per PROMETHEUS_SOURCE — `http://prometheus:9090` for container, empty for disabled. Consumed by Grafana's datasource provisioning.
# (auto-managed)
PROMETHEUS_ENDPOINT=
# Set by ./start.sh from PROMETHEUS_SOURCE; do not edit. 1 runs the prometheus container, 0 does not.
# (auto-managed)
PROMETHEUS_SCALE=
# Set by ./start.sh from PROMETHEUS_SOURCE; do not edit. 1 runs the node-exporter container, 0 does not.
# (auto-managed)
NODE_EXPORTER_SCALE=
# Set by ./start.sh from PROMETHEUS_SOURCE; do not edit. 1 runs the cadvisor container, 0 does not.
# (auto-managed)
CADVISOR_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# infra: Ray (distributed compute substrate)  (services/ray/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: ray-container-cpu | ray-container-gpu | disabled
RAY_SOURCE=disabled

# Image references
# CPU build. Same image used for both head and CPU workers.
RAY_IMAGE=rayproject/ray:2.56.0
# GPU build with CUDA runtime. Selected by ray-container-gpu source.
RAY_GPU_IMAGE=rayproject/ray:2.56.0-gpu

# Loopback-only host port for the Ray dashboard + native REST job-submission API (in-container 8265). Use the authenticated Kong route for remote access.
RAY_DASHBOARD_PORT=63002
# Loopback-only host port for the Ray GCS (in-container 6379). Distinct from the project's Redis cache container; Ray bundles its own GCS process.
RAY_GCS_PORT=63003
# Loopback-only host port for the unauthenticated Ray client server (in-container 10001). Used only by trusted host Python: `ray.init('ray://localhost:<port>')`.
RAY_CLIENT_PORT=63004
# Number of ray-worker containers; 0 runs the head only. The wizard and --ray-worker-count accept 0-64; the wizard default is 2.
RAY_WORKER_COUNT=2
# Set by ./start.sh from RAY_SOURCE; do not edit. 1 runs the ray-head container for the container sources, else 0.
# (auto-managed)
RAY_HEAD_SCALE=
# Resolved by the bootstrapper from RAY_WORKER_COUNT when source is ray-container-{cpu,gpu}; 0 otherwise.
# (auto-managed)
RAY_WORKER_SCALE=
# Resolved per source: `ray://ray-head:10001` for container sources, empty for disabled. Injected into the backend + jupyterhub containers via their compose environment blocks.
# (auto-managed)
RAY_ADDRESS=
# Optional override for the Ray dashboard URL the backend's job client uses. Empty = derive from RAY_ADDRESS (http://ray-head:8265).
RAY_DASHBOARD_URL=
# Memory limit for ray-head (deploy.resources.limits.memory). The head runs the GCS, dashboard and object directory; 4g is safe on a 32 GB host. The shm_size=8gb /dev/shm allocation is separate from this cap.
RAY_HEAD_MEMORY_LIMIT=4g
# Container CPU limit for ray-head (deploy.resources.limits.cpus). GCS + dashboard coordination rarely needs more than 1 core; 2.0 leaves room for brief spikes.
RAY_HEAD_CPU_LIMIT=2.0
# Container memory limit per ray-worker (deploy.resources.limits.memory). Workers run tasks and actors; 4 g per replica is a modest OOM fence on a 32 GB host with the default 2 workers. Raise for large in-memory datasets.
RAY_WORKER_MEMORY_LIMIT=4g
# Container CPU limit per ray-worker (deploy.resources.limits.cpus). 2.0 cores per worker. Raise if workers need more parallelism; lower if the host is saturated.
RAY_WORKER_CPU_LIMIT=2.0

# ──────────────────────────────────────────────────────────────────────────
# data: Redis (cache & queue)  (services/redis/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Image references
# Bumping the redis version: change this default and rerun ./start.sh.
REDIS_IMAGE=redis:7.2.14-alpine
# Prometheus exporter sidecar. Scales 1↔0 with PROMETHEUS_SOURCE (gated by _generate_prometheus_config).
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.86.0

# Single-option source: Redis always runs as a container. It is an env entry, not a sources block, so the wizard shows no one-option dropdown. The source validator expects REDIS_SOURCE=container.
REDIS_SOURCE=container
# Redis memory cap, e.g. 512mb. 0 means unlimited: Redis grows until the container is OOM-killed and loses in-flight queue state. A cap lets REDIS_MAXMEMORY_POLICY shed recomputable data instead. Size it to about 75% of the container memory budget.
REDIS_MAXMEMORY=0
# Eviction policy at REDIS_MAXMEMORY. volatile-lru evicts only keys with a TTL (LiteLLM's response cache). The n8n and Langfuse queues and the backend media store have no TTL and survive. With nothing volatile left, writes fail with OOM.
REDIS_MAXMEMORY_POLICY=volatile-lru
# Host port. Container port is always 6379.
REDIS_PORT=63025
# Used by every consumer (n8n queue, litellm cache,
# open-webui websocket store, backend session/queue, local-deep-
# researcher worker queue). The default is for fresh-install
# convenience only; rotate before any deployment.
# (secret)
REDIS_PASSWORD=redis_password
# Default connection string (database 0, also n8n's queue and LiteLLM's cache). Consumers that need another DB index build their own URL: open-webui and lightrag share /2, jupyterhub uses /3. Compose substitutes REDIS_PASSWORD.
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
# Host port for redis-exporter (in-container 9121). Sidecar gated by PROMETHEUS_SOURCE.
REDIS_EXPORTER_PORT=63026
# Set by _generate_prometheus_config() to 1 when PROMETHEUS_SOURCE=container, 0 otherwise.
# (auto-managed)
REDIS_EXPORTER_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# data: Redpanda (Kafka API streaming)  (services/redpanda/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
REDPANDA_SOURCE=disabled

# Image references
# Pinned to the latest Redpanda 26.1.x maintenance release verified for multi-arch Docker images.
REDPANDA_IMAGE=docker.redpanda.com/redpandadata/redpanda:v26.1.12
# Pinned to the latest Redpanda Console 3.8.x release.
REDPANDA_CONSOLE_IMAGE=docker.redpanda.com/redpandadata/console:v3.8.0

# Host port for the Redpanda Kafka API external listener (in-container 19092).
REDPANDA_KAFKA_PORT=63010
# Host port for Redpanda Console (in-container 8080).
REDPANDA_CONSOLE_PORT=63011
# Comma-separated Kafka topics created idempotently by redpanda-init.
REDPANDA_DEMO_TOPICS=atlas_stream_events
# Set by ./start.sh from REDPANDA_SOURCE; do not edit. 1 runs the redpanda broker, 0 does not.
# (auto-managed)
REDPANDA_SCALE=
# Set by ./start.sh from REDPANDA_SOURCE; do not edit. 1 runs the redpanda-init container, 0 does not.
# (auto-managed)
REDPANDA_INIT_SCALE=
# Set by ./start.sh from REDPANDA_SOURCE; do not edit. 1 runs the redpanda-console container, 0 does not.
# (auto-managed)
REDPANDA_CONSOLE_SCALE=
# In-network Kafka bootstrap servers for Atlas services.
# (auto-managed)
REDPANDA_BROKERS=
# Spark Structured Streaming Kafka bootstrap servers; blank when Redpanda is disabled.
# (auto-managed)
SPARK_KAFKA_BOOTSTRAP_SERVERS=

# ──────────────────────────────────────────────────────────────────────────
# media: SearXNG (privacy metasearch)  (services/searxng/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
SEARXNG_SOURCE=container

# Image references
SEARXNG_IMAGE=searxng/searxng:2026.6.28-357662d86

# Host port for the SearXNG web UI and JSON API (container port 8080). Also sets SEARXNG_BASE_URL.
SEARXNG_PORT=63056
# Auto-generated by bootstrapper.
# (secret)
SEARXNG_SECRET=
# Set by ./start.sh from SEARXNG_SOURCE; do not edit. 1 runs the searxng container, 0 does not.
