ICEBERG_REST_SOURCE=disabled

# Image references
# Base image for the local Atlas build. Atlas layers the PostgreSQL JDBC driver onto the Apache fixture image.
ICEBERG_REST_IMAGE=apache/iceberg-rest-fixture:1.10.1
ICEBERG_REST_INIT_IMAGE=postgres:15.18-alpine

# Host port for the Iceberg REST Catalog API (in-container 8181).
ICEBERG_REST_PORT=63022
ICEBERG_DB_USER=iceberg
# Auto-generated by bootstrapper. Postgres role for the Iceberg JDBC catalog DB.
# (secret)
ICEBERG_DB_PASSWORD=
# PostgreSQL JDBC driver version layered into the local Iceberg REST image build.
ICEBERG_REST_POSTGRES_JDBC_VERSION=42.7.12
# (auto-managed)
ICEBERG_REST_SCALE=
# (auto-managed)
ICEBERG_REST_INIT_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# apps: Jenkins (Maven Spark app builder)  (services/jenkins/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
JENKINS_SOURCE=disabled

# Image references
# Jenkins LTS with JDK 21; Atlas builds a local derived image with Maven, MinIO mc, and plugins. Rolling `lts-jdk21` tag — repointed by Jenkins upstream on each new LTS line, so two builds days apart resolve to different Jenkins versions. Pin to a digest in production via `docker pull jenkins/jenkins:lts-jdk21` then set JENKINS_IMAGE to `jenkins/jenkins:lts-jdk21@sha256:<digest>`.
JENKINS_IMAGE=jenkins/jenkins:lts-jdk21

# Host port for the Jenkins Web UI (in-container 8080).
JENKINS_PORT=63090
# (auto-managed)
JENKINS_SCALE=
# Jenkins admin login created by JCasC.
JENKINS_ADMIN_USER=admin
# Auto-generated on first bootstrap by KeyGenerator.generate_jenkins_admin_password().
# (secret)
JENKINS_ADMIN_PASSWORD=
# Container memory limit for Jenkins controller and local Maven builds.
JENKINS_MEMORY_LIMIT=3g
# Container CPU limit for Jenkins controller and local Maven builds.
JENKINS_CPU_LIMIT=2.0

