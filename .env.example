LITELLM_ENABLED_PROVIDERS=

# ──────────────────────────────────────────────────────────────────────────
# infra: Cloudflare Tunnel (public edge)  (services/cloudflared/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
CLOUDFLARED_SOURCE=disabled

# Image references
# Cloudflare Tunnel daemon. Pin a dated tag; bump deliberately.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.6.1

# Cloudflare named-tunnel token (Zero Trust > Networks > Tunnels). When
# CLOUDFLARED_SOURCE=container this must be set or the daemon exits. The
# tunnel's public hostname is configured in the Cloudflare dashboard to
# point at http://kong-api-gateway:8000.
# (secret)
CLOUDFLARE_TUNNEL_TOKEN=
# Set to 1 when CLOUDFLARED_SOURCE=container, 0 when disabled.
# (auto-managed)
CLOUDFLARED_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# media: ComfyUI (image generation)  (services/comfyui/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container-cpu | container-gpu | localhost | managed-localhost-mps | disabled
COMFYUI_SOURCE=container-cpu

# Image references
# AI-Dock base image; COMFYUI_AUTO_UPDATE + COMFYUI_REF pin the upstream ComfyUI core at startup.
COMFYUI_IMAGE=ghcr.io/ai-dock/comfyui:v2-cpu-22.04-v0.2.7
COMFYUI_INIT_IMAGE=alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

# Init-container selector listed in the SOURCE matrix (container or disabled). No code reads it: COMFYUI_INIT_SCALE follows COMFYUI_SOURCE.
COMFYUI_INIT_SOURCE=container
# Host port that publishes the comfyui container (in-container port 18188).
COMFYUI_PORT=63054
# Host port for the localhost source variant. URL is derived at compose-render time as http://host.docker.internal:8000.
COMFYUI_LOCALHOST_PORT=8000
# Fixed host port the Atlas-managed Apple-Silicon/MPS ComfyUI listens on (source=managed-localhost-mps). Containers reach it as http://host.docker.internal:8188. Named with the _LOCALHOST_ host-port convention so the topology slot allocator leaves the fixed default intact.
COMFYUI_MPS_LOCALHOST_PORT=8188
# Pinned upstream ComfyUI git ref the managed MPS host process checks out (mirrors COMFYUI_REF for the container path). A release tag or full commit SHA.
COMFYUI_MPS_REF=v0.27.0
# Atlas-owned host state directory for the managed MPS ComfyUI: the pinned checkout, its venv, and the pid/log/status files. Never a container volume.
COMFYUI_MPS_STATE_DIR=~/.atlas/comfyui-mps
# Host models directory the managed MPS process reuses via extra_model_paths, so weights are not duplicated. Shared with COMFYUI_LOCAL_MODELS_PATH by default. Under managed-localhost-mps, the host provisioner also downloads COMFYUI_USER_MODELS here at start.
COMFYUI_MPS_MODELS_PATH=~/Documents/ComfyUI/models
# Minimum unified-memory headroom (GiB) the managed MPS preflight requires before launching ComfyUI; below this the preflight warns.
COMFYUI_MPS_MIN_MEMORY_GB=16
# Space-separated pip specifiers for Torch, torchvision and torchaudio that the managed MPS install applies. The pin keeps fresh installs reproducible against COMFYUI_MPS_REF; bump both together. macOS/arm64 Torch wheels include Metal/MPS.
COMFYUI_MPS_TORCH_PIN=torch==2.11.0 torchvision==0.26.0 torchaudio==2.11.0
# Bind address of the managed MPS ComfyUI process. Keep 127.0.0.1 on Docker Desktop/macOS. On Linux engines, host.docker.internal resolves to a bridge address that cannot reach loopback, so set 0.0.0.0. Health probes use 127.0.0.1 for 0.0.0.0 or ::.
COMFYUI_MPS_LISTEN=127.0.0.1
# In-container default. Runtime value is COMFYUI_ENDPOINT computed by hook.
COMFYUI_BASE_URL=http://comfyui:18188
# Passed to the comfyui container as SUPABASE_URL for the inert Supabase output upload. Default http://kong-api-gateway:8000/comfyui.
COMFYUI_KONG_URL=http://kong-api-gateway:8000/comfyui
# ComfyUI launch arguments passed to the AI-Dock image verbatim. The manifest default is --listen; compose falls back to --listen --cpu when the value is unset.
COMFYUI_ARGS=--listen
# AI-Dock startup update flag. Atlas keeps this true so COMFYUI_REF pins the upstream ComfyUI core even when the base image tag lags.
COMFYUI_AUTO_UPDATE=true
# Pinned upstream ComfyUI git ref passed to AI-Dock. Use a release tag or full commit SHA when deliberately changing the ComfyUI core.
COMFYUI_REF=v0.27.0
# Compose platform for the comfyui image (default linux/amd64).
COMFYUI_PLATFORM=linux/amd64
# Inert placeholder. Nothing in the ai-dock image, Atlas provisioning or the backend reads it, so ComfyUI does not upload outputs to Supabase. Kept for a future output-upload custom node.
COMFYUI_UPLOAD_TO_SUPABASE=true
# Reserved bucket name for the (currently inert) COMFYUI_UPLOAD_TO_SUPABASE placeholder; unused until an output-upload node is wired.
COMFYUI_STORAGE_BUCKET=comfyui-images
# Not interpolated by any compose file: comfyui-init sets its own COMFYUI_MODELS_PATH=/models, and the comfyui container mounts models at /opt/ComfyUI/models.
COMFYUI_MODELS_PATH=/opt/ComfyUI/models
# Host models directory of an existing ComfyUI install. With COMFYUI_SOURCE=localhost, ./start.sh warns when it is missing. The comfyui container mounts it read-only at /host_models, which nothing reads.
COMFYUI_LOCAL_MODELS_PATH=~/Documents/ComfyUI/models
# Comma-separated catalog model names picked in the wizard or with --comfyui-models. Read by services/comfyui/init/scripts/download_models.sh, and by the managed-MPS host provisioner, which downloads the same set into COMFYUI_MPS_MODELS_PATH.
COMFYUI_USER_MODELS=
# Path to the ComfyUI custom-models sidecar YAML (user-authored models not in the curated catalog). Read by comfyui_resolver when generating the download manifest, and by the wizard's model picker.
COMFYUI_CUSTOM_MODELS_FILE=/custom-models.yaml
# Path list (os.pathsep-joined) of pinned custom-node allowlist files. The shipped services/comfyui/custom-nodes.yaml is always included; consumer manifests append custom_nodes.comfyui entries, which are always active. The bootstrapper maps selected models' requires_custom_node values through it into active-custom-nodes.tsv.
COMFYUI_CUSTOM_NODES_FILE=/custom-nodes.yaml
# Set by ./start.sh; do not edit. 1 runs the comfyui-init model download for container-* sources, 0 for localhost, managed-localhost-mps and disabled.
# (auto-managed)
COMFYUI_INIT_SCALE=
# Set by ./start.sh from COMFYUI_SOURCE; do not edit. 1 runs the comfyui container for container-cpu and container-gpu, 0 otherwise.
# (auto-managed)
COMFYUI_SCALE=
# Resolved per COMFYUI_SOURCE. Read by backend, celery, open-webui, jupyterhub and downstream overlays; hermes receives it as COMFYUI_INTERNAL_URL. Consumer pattern: MY_URL: ${MY_URL:-${COMFYUI_ENDPOINT:-http://comfyui:18188}}
# (auto-managed)
COMFYUI_ENDPOINT=
# Derived by ./start.sh from the source's runtime deploy block ('~' when empty); do not set. No compose file reads it.
COMFYUI_DEPLOY_RESOURCES=~
# Hard container-memory ceiling for ComfyUI (deploy.resources.limits.memory). The limit does not reserve memory; 40 g permits large multi-file bundles such as Krea 2 while smaller workloads consume only what they need.
COMFYUI_MEMORY_LIMIT=40g
# CPU limit for the comfyui container (deploy.resources.limits.cpus). The 2.0 default stops CPU-mode inference from monopolising the host. GPU mode is GPU-bound, so the cap rarely matters.
COMFYUI_CPU_LIMIT=2.0

# ──────────────────────────────────────────────────────────────────────────
# media: Crawl4AI (JS-capable web extraction)  (services/crawl4ai/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
CRAWL4AI_SOURCE=disabled

# Image references
CRAWL4AI_IMAGE=unclecode/crawl4ai:0.9.0

# Host port that publishes the crawl4ai container API (in-container port 11235).
CRAWL4AI_PORT=63050
# Bearer token required by Crawl4AI's Docker API; auto-generated by the bootstrapper.
# (secret)
CRAWL4AI_API_TOKEN=
# Local Deep Researcher timeout for Crawl4AI extraction calls.
CRAWL4AI_TIMEOUT_SECONDS=30
# Maximum markdown characters Local Deep Researcher keeps from each Crawl4AI result.
CRAWL4AI_MAX_CHARS=60000
# Keep false unless deliberately crawling private/internal URLs from inside the Atlas network.
CRAWL4AI_ALLOW_INTERNAL_URLS=false
# Set by ./start.sh from CRAWL4AI_SOURCE; do not edit. 1 runs crawl4ai, 0 does not.
# (auto-managed)
CRAWL4AI_SCALE=
# Set by ./start.sh; do not edit. http://crawl4ai:11235 when CRAWL4AI_SOURCE=container, else empty. Read by Local Deep Researcher and n8n.
# (auto-managed)
CRAWL4AI_ENDPOINT=

# ──────────────────────────────────────────────────────────────────────────
# media: Docling (document processor)  (services/docling/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: disabled | docling-localhost | docling-container-gpu
DOC_PROCESSOR_SOURCE=disabled

# Image references
# Used as BASE_IMAGE in doc-processor/gpu/Dockerfile.
DOCLING_GPU_IMAGE=pytorch/pytorch:2.13.0-cuda12.6-cudnn9-runtime@sha256:6acf597eeb8e376a96580dde4952f37cc017fef732bb40bfc73f28f25e3f64b4
# Minimal base image for the isolated LightRAG compatibility adapter.
DOCLING_ADAPTER_IMAGE=python:3.12.14-slim

# Host port that publishes the docling-gpu container API (in-container port 8000).
DOC_PROCESSOR_PORT=63051
# Torch device for the docling-gpu container, passed as DOCLING_DEVICE (default cuda).
DOCLING_GPU_DEVICE=cuda
# Default conversion output format when a request sets none: markdown (default), html, json or doctags.
DOCLING_OUTPUT_FORMAT=markdown
# Default OCR mode when a request sets none: auto (default), always or never.
DOCLING_USE_OCR=auto
# Default table-structure mode when a request sets none: accurate (default) or fast.
DOCLING_TABLE_MODE=accurate
# Positive maximum upload bytes for Docling GPU, localhost, and adapter APIs. Request bodies are capped before multipart parsing with 1 MiB framing overhead; invalid values fail startup and oversized requests return 413.
DOCLING_MAX_FILE_SIZE=52428800
# Total seconds (1-3600) allowed to receive one Docling or adapter upload body before a 408 response releases admission capacity.
DOCLING_UPLOAD_TIMEOUT_SECONDS=120
# Maximum concurrent Docling conversions per provider process. Default 1 prevents duplicate model loads and GPU memory contention.
DOCLING_CONCURRENCY=1
# Auto-generated bearer credential required by Docling routes except /health.
# (secret)
DOCLING_API_TOKEN=
# Provider authentication mode: required (default) or disabled for an explicit emergency/local rollback.
DOCLING_AUTH_MODE=required
# Optional comma-separated browser origin allowlist. Empty disables CORS; wildcard is invalid while authentication is required.
DOCLING_CORS_ORIGINS=
# Finite conversion and lazy-load deadline in seconds (1-3600). A timeout returns 504 and then exits the provider process for restart.
DOCLING_INFERENCE_TIMEOUT_SECONDS=900
# Native Docling listen address. Set another interface explicitly only when remote access is intended.
DOCLING_LOCALHOST_BIND_HOST=127.0.0.1
# Maximum outstanding LightRAG adapter jobs, reserved before multipart parsing.
DOCLING_ADAPTER_MAX_JOBS=2
# Seconds a completed LightRAG adapter result may remain before verified artifact cleanup begins; the job slot stays occupied and cleanup is retried if deletion fails.
DOCLING_ADAPTER_RESULT_TTL_SECONDS=900
# Maximum ZIP result bytes streamed from Docling to adapter storage before the job fails safely.
DOCLING_ADAPTER_MAX_RESULT_BYTES=104857600
# Total bounded Docling request attempts when the provider returns HTTP 429.
DOCLING_ADAPTER_UPSTREAM_MAX_ATTEMPTS=3
# Positive maximum seconds for one result transmission; expiry starts verified artifact cleanup, and the adapter slot is released only after deletion succeeds.
DOCLING_ADAPTER_DOWNLOAD_TIMEOUT_SECONDS=300
# Size of the adapter's bounded temporary-storage mount. It must cover MAX_JOBS times the larger of upload + 1 MiB multipart overhead or upload + result limit, plus at least 64 MiB staging headroom. Startup fails if capacity is smaller.
DOCLING_ADAPTER_TMPFS_SIZE=512m
# Derived adapter replica count; one only when both LightRAG and Docling are enabled.
# (auto-managed)
DOCLING_ADAPTER_SCALE=
# Authenticated internal bundle route selected for the adapter; never exposed to LightRAG.
# (auto-managed)
DOCLING_ADAPTER_UPSTREAM_ENDPOINT=
# Enables formula enrichment in the Docling pipeline: true (default) or false; other values fail.
DOCLING_ENABLE_FORMULAS=true
# Enables code-block enrichment in the Docling pipeline: true (default) or false; other values fail.
DOCLING_ENABLE_CODE_BLOCKS=true
# Default chunk size for chunked conversions. Must be a positive integer.
DOCLING_CHUNK_SIZE=512
# Default chunk overlap. Must be non-negative and at most half of DOCLING_CHUNK_SIZE; invalid values fail startup.
DOCLING_CHUNK_OVERLAP=50
# Set by ./start.sh from DOC_PROCESSOR_SOURCE; do not edit. 1 runs docling-gpu for docling-container-gpu, 0 otherwise.
# (auto-managed)
DOCLING_GPU_SCALE=
# Set by ./start.sh from DOC_PROCESSOR_SOURCE; do not edit. Docling URL (empty when disabled) read by backend, celery, jupyterhub and n8n.
# (auto-managed)
DOCLING_ENDPOINT=
# Host port for the localhost source variant. URL is derived at compose-render time as http://host.docker.internal:18159.
DOCLING_LOCALHOST_PORT=18159

# ──────────────────────────────────────────────────────────────────────────
# media: FAL Cloud Media  (services/fal/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: enabled | disabled
FAL_SOURCE=disabled

# fal.ai API key. Required only when FAL_SOURCE=enabled. The backend also exposes it to fal-client as FAL_KEY.
# (secret)
FAL_API_KEY=
# Default fal.ai model endpoint used by the media gateway for text-to-image generation.
FAL_MODEL=fal-ai/flux/dev
# Default fal.ai endpoint id for the media gateway's image_to_3d modality. Must resolve to a verified registry entry (Hunyuan3D / TRELLIS / Tripo / Rodin); TRELLIS is the MIT-licensed default.
FAL_IMAGE_TO_3D_MODEL=fal-ai/trellis
# License or terms marker returned in normalized media operation responses when provider-specific model licensing is not more specific.
FAL_MODEL_LICENSE=fal/provider-terms
# Finite Backend timeout budget for FAL media submit/poll operations and the compatibility route. Must be greater than zero and at most 3600 seconds.
FAL_TIMEOUT_SECONDS=120
# Requested output format for compatible fal.ai image models: jpeg or png.
FAL_OUTPUT_FORMAT=jpeg
# Whether to request the provider-side safety checker for compatible fal.ai image models.
FAL_ENABLE_SAFETY_CHECKER=true

# ──────────────────────────────────────────────────────────────────────────
# infra: Globals (project + branding)  (services/globals/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Docker Compose project name: the prefix for containers, volumes and networks, and the `docker compose -p` namespace. start.sh and stop.sh both read it. `./start.sh --project <name>` (or -p) writes it here. Use a unique name for a submodule consumer.
PROJECT_NAME=atlas
# Base port. Every service's *_PORT derives from this + a fixed offset.
BASE_PORT=63000
# Published-port interface prefix (trailing colon). Default 127.0.0.1: is host-only; 0.0.0.0: is for deliberate remote access. Existing .env files with HOST_BIND_IP= are upgraded by backfill. Empty binds all interfaces except Ray, Zeppelin, mcp-servers, Supabase DB, Docling, Parakeet. LAN Supabase routes: KONG_SUPABASE_EXTRA_HOSTS.
HOST_BIND_IP=127.0.0.1:
# Set by ./start.sh for the container runtime: host-gateway on Docker, the literal gateway IP on Podman. If you write .env without ./start.sh, use host-gateway on Docker, or the real bridge IP on rootless setups.
# (auto-managed)
HOST_GATEWAY_IP=
# Wizard branding: the brand name shown by the wizard and --no-tui banner. Empty uses the Atlas default.
BRAND_NAME=Atlas
# Wizard branding: the tagline shown by the wizard and --no-tui banner. Empty uses the Atlas default.
BRAND_TAGLINE=A self-hosted, source-configurable, multi-disciplinary engineering platform — gen-AI, ML, and data.
# Wizard branding: the version shown by the wizard and --no-tui banner. Empty uses the Atlas default.
BRAND_VERSION=0.1.0
# Wizard branding: the author shown by the wizard and --no-tui banner. Empty uses the Atlas default.
BRAND_AUTHOR=Kaveh Razavi
# Wizard branding: the author email shown by the wizard and --no-tui banner. Empty uses the Atlas default.
BRAND_AUTHOR_EMAIL=kaveh.razavi@gmail.com
# Wizard branding: the license shown by the wizard and --no-tui banner. Empty uses the Atlas default.
BRAND_LICENSE=Apache License 2.0
# Wizard branding: the repository URL shown by the wizard and --no-tui banner. Empty uses the Atlas default.
BRAND_REPO_URL=https://github.com/thekaveh/atlas
# Optional path to a block-art logo that replaces the built-in ATLAS lockup in the wizard and --no-tui banner. Empty keeps ATLAS. Keep it 6 rows tall. File format: docs/quick-start/interactive-setup-wizard.md (Brand Customization).
BRAND_LOGO_FILE=
# Docker Compose profile activation list. Rebuilt from scratch on every
# ./start.sh run from the active STT/TTS/doc-processor sources
# (speaches-cpu/-gpu, parakeet-gpu, chatterbox-gpu, docling-gpu/doc-gpu).
# Do not edit by hand — the bootstrapper owns this value.
# (auto-managed)
COMPOSE_PROFILES=
# Host-side GPU visibility. Forwarded into every NVIDIA-runtime container.
NVIDIA_VISIBLE_DEVICES=all
# Reserved default container CPU cap (cores). No compose fragment reads it yet.
PROD_ENV_CPUS=2
# Reserved default container memory cap. No compose fragment reads it yet.
PROD_ENV_MEM_LIMIT=8g
# Reserved backend CPU cap (cores). No compose fragment reads it yet; the backend runs unbounded.
PROD_ENV_BACKEND_CPUS=1
# Reserved backend memory cap. No compose fragment reads it yet; the backend runs unbounded.
PROD_ENV_BACKEND_MEM_LIMIT=2g
# Reserved n8n CPU cap (cores). No compose fragment reads it yet; n8n runs unbounded.
PROD_ENV_N8N_CPUS=1
# Reserved n8n memory cap. No compose fragment reads it yet; n8n runs unbounded.
PROD_ENV_N8N_MEM_LIMIT=2g
# CPU limit (cores) for ComfyUI with COMFYUI_SOURCE=container-gpu. The CPU variant uses COMFYUI_CPU_LIMIT instead.
PROD_ENV_COMFYUI_CPUS=2
# Memory limit for ComfyUI with COMFYUI_SOURCE=container-gpu. The CPU variant uses COMFYUI_MEMORY_LIMIT instead.
PROD_ENV_COMFYUI_MEM_LIMIT=4g
# Per-container json-file log max size (Docker logging option).
LOG_MAX_SIZE=10m
# Per-container json-file log file count (Docker logging option).
LOG_MAX_FILE=3
# Env-migration sentinel. A missing value or one below 5 runs the chained migrations up to v5. They cover port layout, URL to PORT, ComfyUI model set, stale Ollama model cleanup and Weaviate backup-filesystem. Fresh .env files are v5.
BOOTSTRAPPER_PORT_LAYOUT_VERSION=5

# ──────────────────────────────────────────────────────────────────────────
# infra: Grafana (observability UI + alerting)  (services/grafana/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
GRAFANA_SOURCE=disabled

# Image references
GRAFANA_IMAGE=grafana/grafana:11.4.3

# Host port for Grafana's HTTP server (in-container 3000).
GRAFANA_PORT=63009
# Grafana admin login. Override in .env if needed.
GRAFANA_ADMIN_USERNAME=admin
# Auto-generated on first bootstrap and saved to .env. Grafana applies it only when it creates its database on an empty grafana-data volume. To rotate, run `grafana cli admin reset-admin-password` in the container, then update .env.
GRAFANA_ADMIN_PASSWORD=
# Set by ./start.sh from GRAFANA_SOURCE; do not edit. http://grafana:3000 for the container source, empty when disabled.
# (auto-managed)
GRAFANA_ENDPOINT=
# Set by ./start.sh from GRAFANA_SOURCE; do not edit. 1 runs grafana, 0 does not.
# (auto-managed)
GRAFANA_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# agents: Hermes (programmable AI agent)  (services/hermes/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | localhost | disabled
HERMES_SOURCE=container

# Image references
HERMES_IMAGE=nousresearch/hermes-agent:v2026.6.19
HERMES_INIT_IMAGE=alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

# Host port for the Hermes Agent OpenAI-compatible API (in-container listen port is 8642).
HERMES_API_PORT=63072
# Host port for the Hermes Agent web dashboard (in-container listen port is 9119).
HERMES_DASHBOARD_PORT=63073
# Memory limit of the hermes container.
HERMES_MEMORY_LIMIT=4g
# CPU limit (cores) of the hermes container.
HERMES_CPU_LIMIT=2.0
# Auto-generated by bootstrapper. Hermes's API server bearer key, passed to Hermes as API_SERVER_KEY; LiteLLM's hermes-agent row reads the same value as HERMES_API_KEY.
# (secret)
HERMES_API_KEY=
# Empty = hermes-init picks from LiteLLM /v1/models priority list.
HERMES_DEFAULT_MODEL=
# Context length hermes-init writes into config.yaml for the default model. Hermes requires a model context window of at least 64K.
HERMES_CONTEXT_LENGTH=65536
# Runs the Hermes web dashboard (passed as HERMES_DASHBOARD). Set false to remove the dashboard, including its Chat tab.
HERMES_DASHBOARD_ENABLED=true
# Inert: Hermes v2026.6.19 always embeds the dashboard Chat tab (PTY terminal) and ignores this value; disable the dashboard (HERMES_DASHBOARD_ENABLED=false) to remove it.
HERMES_DASHBOARD_TUI=1
# Lets the dashboard bind 0.0.0.0 without a Nous Portal OAuth provider; without it the dashboard restart-loops. The dashboard then has no login: the direct port and backend-network peers reach it unauthenticated. Set false plus HERMES_DASHBOARD_OAUTH_CLIENT_ID to enforce OAuth.
HERMES_DASHBOARD_INSECURE=true
# Container user — match a host UID to read hermes-data from outside.
HERMES_UID=10000
# Container group ID; hermes-init chowns hermes-data to HERMES_UID:HERMES_GID.
HERMES_GID=10000
# Host port for the Hermes API in the localhost source variant. Consumed by HERMES_ENDPOINT (in-container clients call this). Defaults to Hermes' native API port.
HERMES_LOCALHOST_PORT=8642
# Host port of the Hermes dashboard for HERMES_SOURCE=localhost; the hermes.localhost Kong route targets it. Default: the native dashboard port. The wizard edits only HERMES_LOCALHOST_PORT, so set this one in .env.
HERMES_LOCALHOST_DASHBOARD_PORT=9119
# Auto-managed by hermes. Container/disabled.
HERMES_INIT_SOURCE=container
# Set by ./start.sh from HERMES_SOURCE; do not edit. 1 runs hermes-init only for the container source, else 0.
# (auto-managed)
HERMES_INIT_SCALE=
# Set by ./start.sh from HERMES_SOURCE; do not edit. 1 runs the hermes container only for the container source, else 0.
# (auto-managed)
HERMES_SCALE=
# Resolved per HERMES_SOURCE. Consumed by n8n, jupyterhub, LiteLLM model_list; also env-pre-wired for backend + openclaw (not yet exercised).
# (auto-managed)
HERMES_ENDPOINT=
# Set by ./start.sh from TTS_PROVIDER_SOURCE; do not edit. hermes-init renders the TTS block of config.yaml from it; empty omits the block.
# (auto-managed)
TTS_INTERNAL_URL=
# Set by ./start.sh from STT_PROVIDER_SOURCE; do not edit. hermes-init renders the STT block of config.yaml from it; empty omits the block.
# (auto-managed)
STT_INTERNAL_URL=
# Parakeet bearer token for the rendered server-side STT block; non-secret compatibility placeholder for other enabled STT engines.
# (auto-managed, secret)
STT_INTERNAL_API_KEY=
# Set by ./start.sh from COMFYUI_ENDPOINT; do not edit. hermes-init renders the ComfyUI host skill from it; empty skips the skill.
# (auto-managed)
COMFYUI_INTERNAL_URL=
# Set by ./start.sh from SEARXNG_SOURCE; do not edit. hermes-init renders the web-search block of config.yaml from it; empty omits the block.
# (auto-managed)
SEARXNG_INTERNAL_URL=
# Set by ./start.sh from LIGHTRAG_ENDPOINT; do not edit. hermes-init receives it, but config.yaml has no LightRAG block; Hermes reaches LightRAG through LiteLLM.
# (auto-managed)
LIGHTRAG_INTERNAL_URL=

# ──────────────────────────────────────────────────────────────────────────
# data: Apache Iceberg REST Catalog  (services/iceberg-rest/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
ICEBERG_REST_SOURCE=disabled

# Image references
# Base image for the local Atlas build. Atlas layers the PostgreSQL JDBC driver onto the Apache fixture image.
ICEBERG_REST_IMAGE=apache/iceberg-rest-fixture:1.10.1
ICEBERG_REST_INIT_IMAGE=postgres:15.19-alpine

# Host port for the Iceberg REST Catalog API (in-container 8181).
ICEBERG_REST_PORT=63022
# Scoped Postgres login for the catalog JDBC store (database iceberg). Supabase db-init (05-scoped-roles.sh) creates it.
ICEBERG_DB_USER=iceberg
# Auto-generated by bootstrapper. Postgres role for the Iceberg JDBC catalog DB.
# (secret)
ICEBERG_DB_PASSWORD=atlas-db-password
# PostgreSQL JDBC driver version layered into the local Iceberg REST image build.
ICEBERG_REST_POSTGRES_JDBC_VERSION=42.7.12
# SHA-512 digest required for the PostgreSQL JDBC driver selected above. Update both values together.
ICEBERG_REST_POSTGRES_JDBC_SHA512=3759e7160591863e5100361298943df94488a6e4ee03936d20723638142fe8038c9a6a47fa8ee7e424f4ef09bb351edc89dfe2ae4acdfc0f92699a8b00196c5c
# Set by ./start.sh from ICEBERG_REST_SOURCE; do not edit. 1 runs iceberg-rest, 0 does not.
# (auto-managed)
ICEBERG_REST_SCALE=
# Set by ./start.sh from ICEBERG_REST_SOURCE; do not edit. 1 runs iceberg-rest-init, 0 does not.
# (auto-managed)
ICEBERG_REST_INIT_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# apps: Jenkins (Maven Spark app builder)  (services/jenkins/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
JENKINS_SOURCE=disabled

# Image references
# Jenkins LTS with JDK 21; Atlas builds a local derived image with Maven, MinIO mc, and plugins. The default pins `lts-jdk21` to a reviewed digest, because the bare tag moves on each new LTS line. To refresh, run `docker pull jenkins/jenkins:lts-jdk21` and set the new digest.
JENKINS_IMAGE=jenkins/jenkins:lts-jdk21@sha256:c1e4c349365f6d16d88595b2c5f7e8ff39b8ae1d061f62420bac193b4b9616d0

# Host port for the Jenkins Web UI (in-container 8080).
JENKINS_PORT=63090
# Set by ./start.sh from JENKINS_SOURCE; do not edit. 1 runs the Jenkins controller, 0 does not.
# (auto-managed)
JENKINS_SCALE=
# Jenkins admin login created by JCasC.
JENKINS_ADMIN_USER=admin
# Auto-generated on first bootstrap by KeyGenerator.generate_jenkins_admin_password().
# (secret)
JENKINS_ADMIN_PASSWORD=
# Container memory limit for Jenkins controller and local Maven builds.
JENKINS_MEMORY_LIMIT=3g
# Container CPU limit for Jenkins controller and local Maven builds.
JENKINS_CPU_LIMIT=2.0

# ──────────────────────────────────────────────────────────────────────────
# apps: JupyterHub (DS/ML + LLM notebooks)  (services/jupyterhub/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
JUPYTERHUB_SOURCE=container

# Image references
JUPYTERHUB_IMAGE=quay.io/jupyter/datascience-notebook:2026-08-24@sha256:e5029672ab8a861345f117dc466a4dab91ad7c299f3c7c853b9b193860b16aaf

# Read-only PostgreSQL login exposed to curated notebooks.
JUPYTER_DB_USER=atlas_jupyter
# Auto-generated password for JupyterHub's read-only database role.
# (secret)
JUPYTER_DB_PASSWORD=atlas-db-password
# Bootstrapper-synchronized percent-encoded JUPYTER_DB_USER for DSN userinfo.
JUPYTER_DB_USER_URI=atlas_jupyter
# Bootstrapper-synchronized percent-encoded JUPYTER_DB_PASSWORD for DSN userinfo.
# (secret)
JUPYTER_DB_PASSWORD_URI=atlas-db-password
# Host port for the JupyterLab server (in-container 8888).
JUPYTERHUB_PORT=63094
# Optional. Empty = generate on start.
# (secret)
JUPYTERHUB_TOKEN=
# Allowed browser origin for Jupyter Server websocket upgrades. Empty keeps Jupyter's same-origin check; token clients such as VS Code do not need '*'. Set one exact origin only for a browser page on another origin.
JUPYTER_ALLOW_ORIGIN=
# Spark Connect endpoint used by bundled notebooks; override for a remote or managed Spark Connect server.
SPARK_REMOTE=sc://spark-connect:15002
# Streamable HTTP URL for the Curated MCP Servers endpoint. The bootstrapper sets http://mcp-servers:8000/mcp only for MCP_SERVERS_SOURCE=container and clears it when disabled.
# (auto-managed)
MCP_SERVERS_URL=
# Set by ./start.sh from JUPYTERHUB_SOURCE; do not edit. 0 when disabled, else 1.
# (auto-managed)
JUPYTERHUB_SCALE=

# ──────────────────────────────────────────────────────────────────────────
# infra: Kong (API gateway)  (services/kong/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Image references
KONG_API_GATEWAY_IMAGE=kong:3.9.3

# Single-option (container only).
KONG_API_GATEWAY_SOURCE=container
# Host port for the Kong HTTP proxy (in-container 8000). Every *.localhost route uses it.
KONG_HTTP_PORT=63000
# Host port for the Kong HTTPS proxy (in-container 8443).
KONG_HTTPS_PORT=63001
# Comma-separated exact browser origins (scheme://host[:port]) Kong allows cross-origin, beyond *.localhost, localhost and 127.0.0.1. Values are normalised; wildcards and paths are ignored with a warning. Read at Kong config generation.
KONG_CORS_EXTRA_ORIGINS=
# Comma-separated extra lowercase Host names (bare hostname or IPv4) the Supabase API routes answer on, beyond the local defaults. Use for a tunnel, LAN address or custom API_EXTERNAL_URL host. Other Hosts get 404. Read at Kong config generation.
KONG_SUPABASE_EXTRA_HOSTS=
# Username of Kong's Basic-auth dashboard consumer, which gates Supabase Studio, /pg/ and other dashboard routes such as hermes.localhost.
DASHBOARD_USERNAME=kong_admin
# Auto-generated on first ./start.sh when left at the placeholder (rotate-when-absent, like MINIO_ROOT_PASSWORD). Gates the Kong-routed Studio dashboard via basic-auth.
# (secret)
DASHBOARD_PASSWORD=kong_password

