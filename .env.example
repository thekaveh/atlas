# ──────────────────────────────────────────────────────────────────────────
# data: Supavisor (Postgres transaction pooler)  (services/supavisor/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container | disabled
SUPAVISOR_SOURCE=disabled

# Image references
SUPAVISOR_IMAGE=supabase/supavisor:2.9.5

# 1 when SUPAVISOR_SOURCE=container, otherwise 0.
# (auto-managed)
SUPAVISOR_SCALE=
# Supavisor tenant suffix. Clients connect as <db_user>.<tenant>.
SUPAVISOR_TENANT_ID=atlas
# Default upstream Postgres pool size for the Atlas tenant.
SUPAVISOR_DEFAULT_POOL_SIZE=20
# Maximum client connections accepted by the Atlas tenant.
SUPAVISOR_MAX_CLIENT_CONN=100
# Supavisor metadata database pool size.
SUPAVISOR_DB_POOL_SIZE=5
# Generated Postgres URL consumed by backend/Celery; points at Supavisor when enabled and direct Supabase Postgres when disabled.
# (auto-managed)
SUPAVISOR_DATABASE_URL=
# Generated n8n Postgres host; supavisor when enabled, supabase-db when disabled.
# (auto-managed)
SUPAVISOR_DB_HOST=
# Generated n8n Postgres port; 6543 when enabled, 5432 when disabled.
# (auto-managed)
SUPAVISOR_DB_PORT_VALUE=
# Generated n8n Postgres user; appends .${SUPAVISOR_TENANT_ID} when Supavisor is enabled.
# (auto-managed)
SUPAVISOR_DB_USER=
# Supavisor Phoenix secret; auto-generated by the bootstrapper when blank.
# (secret)
SUPAVISOR_SECRET_KEY_BASE=
# Supavisor vault encryption key; must be exactly 32 bytes and is auto-generated when blank.
# (secret)
SUPAVISOR_VAULT_ENC_KEY=
# Supavisor tenant API JWT secret; auto-generated by the bootstrapper when blank.
# (secret)
SUPAVISOR_API_JWT_SECRET=
# Supavisor metrics JWT secret; auto-generated by the bootstrapper when blank.
# (secret)
SUPAVISOR_METRICS_JWT_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# llm: TEI Reranker (mxbai-rerank-base-v1)  (services/tei-reranker/service.yml)
# ──────────────────────────────────────────────────────────────────────────
# Source variant. Options: container-cpu | container-gpu | localhost | disabled
TEI_RERANKER_SOURCE=disabled

# Image references
# Used when TEI_RERANKER_SOURCE=container-cpu on amd64 hosts. Compiled with ORT backend (requires ONNX model weights).
TEI_RERANKER_CPU_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
# Used when TEI_RERANKER_SOURCE=container-cpu on arm64 hosts (Apple Silicon). Compiled with candle backend (loads safetensors natively, no ONNX required). Unversioned tag — HF doesn't publish versioned arm64 tags as of 2026-06-06.
TEI_RERANKER_CPU_ARM64_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-latest
# Used when TEI_RERANKER_SOURCE=container-gpu. CUDA host required.
TEI_RERANKER_GPU_IMAGE=ghcr.io/huggingface/text-embeddings-inference:1.9

# Host port for the TEI rerank API (in-container listen port is 80).
TEI_RERANKER_PORT=63041
# Host port for the host-installed TEI rerank source variant.
TEI_RERANKER_LOCALHOST_PORT=63049
TEI_RERANKER_MODEL_ID=mixedbread-ai/mxbai-rerank-base-v1
TEI_RERANKER_REVISION=main
TEI_RERANKER_MAX_CLIENT_BATCH_SIZE=32
TEI_RERANKER_MEMORY_LIMIT=4g
TEI_RERANKER_CPU_LIMIT=2.0
TEI_RERANKER_HF_CACHE_DIR=/data
# (auto-managed)
TEI_RERANKER_SCALE=
# Resolved per TEI_RERANKER_SOURCE. Exposes TEI's rerank endpoint to compatible consumers.
# (auto-managed)
TEI_RERANKER_ENDPOINT=
# Image picked per source variant (CPU vs GPU).
# (auto-managed)
TEI_RERANKER_IMAGE_RESOLVED=

